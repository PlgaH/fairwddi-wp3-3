  skos:altLabel "APUKOULUT"@fi, "ERITYISLUOKAT"@fi, "FOERDERSCHULEN"@de, "INSTITUCIONES EDUCATIVAS PARA PERSONAS CON DISCAPACIDAD"@es,
    "NEĮGALIŲJŲ MOKYKLOS"@lt, "ȘCOLI SPECIALE"@ro, "ŠKOLY PRO HANDICAPOVANÉ"@cs, "ŠKOLY PRO POSTIŽENÉ"@cs,
    "SONDERSCHULEN"@de, "TARKKAILULUOKAT"@fi, "ÉCOLES SPÉCIALISÉES POUR PERSONNES EN SITUATION DE HANDICAP"@fr,
    "MOKYKLOS NEĮGALIESIEMS"@lt, "SÄRSKOLOR"@sv, "SCHOOLS FOR THE DISABLED"@en, "SKÓLAR FYRIR FATLAÐA"@is,
