    "SVETLOBNO ONESNAŽEVANJE"@sl, "VALOSAASTE"@fi, "ŽEMAS TARŠOS LYGIS"@lt, "ΦΩΤΟΡΥΠΑΝΣΗ"@el;
  skos:altLabel "LICHTSMOG"@de;
