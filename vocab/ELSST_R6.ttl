  skos:definition "AVAILABLE MEANS OR ASSETS, INCLUDING SOURCES OF ASSISTANCE, SUPPLY, OR SUPPORT"@en,
    "BESCHIKBARE MIDDELEN OF ACTIVA, MET INBEGRIP VAN BRONNEN VAN BIJSTAND, LEVERING OF ONDERSTEUNING"@nl,
    "LOS MEDIOS O ACTIVOS DISPONIBLES, INCLUIDAS LAS FUENTES DE ASISTENCIA, SUMINISTRO O APOYO"@es,
    "MOYENS DISPONIBLES OU AVOIRS, Y COMPRIS CANAUX D'ASSISTANCE, RÉSERVES, OU SUPPORT (NOTE: SI POSSIBLE UTILISER UN TERME PLUS PRÉCIS)."@fr,
    "REZERVĂ SAU SURSĂ DE MIJLOACE SAU BUNURI SUSCEPTIBILE DE A FI VALORIFICATE ÎNTR-O ÎMPREJURARE DATĂ. POATE INCLUDE SURSE DE SUPORT, ASISTENȚĂ."@ro,
    "TILGJENGELIGE MIDLER ELLER GODER, INKLUDERT KILDER TIL ASSISTANSE, FORSYNING ELLER STØTTE"@no,
    "TILLGÄNGLIGA MEDEL ELLER TILLGÅNGAR, INKLUSIVE KÄLLOR TILL BISTÅND, FÖRSÖRJNING ELLER STÖD."@sv,
    "TURIMOS PRIEMONĖS IR TURTAS, ĮSKAITANT PARAMOS AR IŠTEKLIŲ ŠALTINIUS"@lt, "VERFÜGBARE MITTEL ODER WIRTSCHAFTSGÜTER, AUCH HILFELEISTUNG, VERSORGUNG ODER UNTERSTÜTZUNG."@de;
  skos:scopeNote "ANVÄND OM MÖJLIGT EN MER SPECIFIK TERM."@sv, "EN LO POSIBLE, UTILIZAR UN TÉRMINO MÁS ESPECÍFICO"@es,
    "KÄYTÄ TARKEMPAA TERMIÄ MIKÄLI MAHDOLLISTA."@fi, "JEIGU ĮMANOMA, VARTOKITE KONKRETESNĮ TERMINĄ."@lt,
