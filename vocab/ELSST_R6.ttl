    "KEMPERIŲ AIKŠTELĖS"@lt, "MATKAILUVAUNU-ALUEET"@fi, "STOVYKLAVIETĖS"@lt, "TÄLT- OCH HUSVAGNSCAMPINGAR"@sv,
