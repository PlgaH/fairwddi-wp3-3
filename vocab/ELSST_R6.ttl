<https://elsst.cessda.eu/id/6/8e11d327-3cac-481c-93ae-70362fd5998b> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/8e11d327-3cac-481c-93ae-70362fd5998b>;
  skos:definition "CARE OF CHILDREN BY PARENTS, GUARDIANS OR OTHER PRIMARY CARERS"@en,
    "ÎNGRIJIREA COPIILOR DE CĂTRE PĂRINȚI, TUTORI SAU ALȚE PRESOANE CARE DEȚIN TUTELA ACESTORA. A NU SE CONFUNDA CU 'CREȘE ȘI GRĂDINIȚE CU PROGRAM DE ZI'."@ro,
    "LASTEN HOITO KOTONA VANHEMMAN/HUOLTAJAN TOIMESTA."@fi, "OMHÄNDERTAGANDE AV BARN AV FÖRÄLDRAR, VÅRDNADSHAVARE ELLER ANDRA PRIMÄRA OMSORGSPERSONER."@sv,
    "OMSORG FOR BARN AV FORELDRE, VERGER ELLER ANDRE PRIMÆRE OMSORGSGIVERE"@no, "SOINS DISPENSÉS AUX ENFANTS PAR LES PARENTS, TUTEURS OU D’AUTRES PERSONNES CHARGÉES DE LEUR GARDE."@fr,
    "VERSORGUNG VON KINDERN DURCH DIE ELTERN, ERZIEHUNGSBERECHTIGTEN ODER ANDERE VERANTWORTLICHE."@de,
    "ZORG VOOR KINDEREN DOOR OUDERS, VOOGDEN OF ANDERE PRIMAIRE VERZORGERS"@nl, "TĖVŲ, GLOBĖJŲ AR KITŲ GLOBĖJŲ VYKDOMA VAIKŲ PRIEŽIŪRA."@lt,
    "CUIDADO INFANTIL POR PARTE DE PADRES, TUTORES U OTROS CUIDADORES PRIMARIOS"@es;
  skos:scopeNote "BITTE NICHT MIT DEM BEGRIFF 'KINDERTAGESBETREUUNG' VERWECHSELN."@de,
    "DO NOT CONFUSE WITH 'CHILD DAY CARE'."@en, "MÅ IKKE FORVEKSLES MED 'DAGOMSORG FOR BARN'"@no,
    "MUIDEN ANTAMASTA LASTENHOIDOSTA KÄYTÄ TERMIÄ 'PÄIVÄHOITO'."@fi, "NE PAS CONFONDRE AVEC 'SERVICES DE GARDE D'ENFANTS'"@fr,
    "NEPAINIOTI SU „VAIKŲ DIENOS PRIEŽIŪRA“."@lt, "NIET VERWARREN MET 'KINDERDAGOPVANG'"@nl,
    "NO CONFUNDIR CON EL TÉRMINO \"CUIDADO DE MENORES DIURNO\""@es, "SKA INTE BLANDAS IHOP MED 'BARNDAGVÅRD'."@sv;
