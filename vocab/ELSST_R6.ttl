<https://elsst.cessda.eu/id/6/f21ef463-b545-4c3f-a5cb-df9d874672b4> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/f21ef463-b545-4c3f-a5cb-df9d874672b4>;
  skos:definition "Å KOMME SEG FRA ET STED TIL ET ANNET. ."@no, "ATT FÖRFLYTTA SIG MELLAN OLIKA PLATSER."@sv,
    "DEPLASARE, MIȘCARE DINTR-UN LOC ÎN ALTUL (DEX). A NU SE CONFUNDA CU 'MERS PE JOS', TERMEN CARE SE REFERĂ LA MERSUL PE JOS ÎN ANUMITE SCOPURI, CUM AR FI CELE DE A AJUNGE ÎNTR-UN PUNCT BINE STABILIT, CELE DE RECREERE, DE FITNESS SAU DE CONCURSURI DE MERS PE JOS. "@ro,
    "DESPLAZARSE DE UN LUGAR A OTRO."@es, "GETTING FROM ONE POINT TO ANOTHER"@en, "JUDĖJIMAS IŠ VIENOS VIETOS Į KITĄ."@lt,
    "KYKY KÄVELLÄ ITSENÄISESTI YHDESTÄ PISTEESTÄ TOISEEN."@fi, "SE RENDRE D’UN POINT À UN AUTRE."@fr,
    "VON EINEM ORT ZU EINEM ANDEREN GELANGEN. BITTE NICHT VERWECHSELN MIT DEM BEGRIFF 'GEHEN', DER ENTWEDER FÜR ZIELGERICHTETES FORTBEWEGEN ZU EINEM ORT ODER FÜR DAS GEHEN AUS ERHOLUNGS-, FITNESS- ODER WETTKAMPFGRÜNDEN VERWENDET WIRD."@de,
    "ΑΝΑΦΕΡΕΤΑΙ ΣΤΗ ΜΕΤΑΒΑΣΗ ΑΠΟ ΕΝΑ ΣΗΜΕΙΟ ΣΕ ΕΝΑ ΑΛΛΟ. ΝΑ ΜΗΝ ΣΥΓΧΕΕΤΑΙ ΜΕ ΤΟ «ΒΑΔΙΣΜΑ», ΟΡΟΣ Ο ΟΠΟΙΟΣ ΑΝΑΦΕΡΕΤΑΙ ΣΤΗ ΣΚΟΠΙΜΗ ΜΕΤΑΚΙΝΗΣΗ ΠΡΟΣ ΚΑΠΟΙΑ ΚΑΤΕΥΘΥΝΣΗ Ή ΓΙΑ ΑΝΑΨΥΧΗ, ΑΣΚΗΣΗ Ή ΑΓΩΝΑ. "@el;
  skos:scopeNote "DO NOT CONFUSE WITH 'WALKING' USED FOR PURPOSEFUL LOCOMOTION TO GET SOMEWHERE OR FOR RECREATION, FITNESS OR COMPETITION."@en,
    "MÅ IKKE FORVEKSLES MED ”GANGE” SOM BLIR BENYTTET NÅR EN MED HENSIKT SKAL GÅ ET STED ELLER FOR REKREASJON, KONDISJON ELLER KONKURRANSE"@no,
    "NE PAS CONFONDRE AVEC 'MARCHER' QUI EST UTILISÉ POUR DÉSIGNER LA LOCOMOTION CIBLÉE POUR SE RENDRE À UN LIEU PRÉCIS OU À DES FINS RÉCRÉATIVES, D’EXERCICE PHYSIQUE OU DE COMPÉTITION."@fr,
    "NEPAINIOTI SU TERMINU „ĖJIMAS“ VARTOJAMU TIKSLINGAM JUDĖJIMUI AR POILSIAUJANT, TRENIRUOJANTIS ARBA RUNGTYNIAUJANT."@lt,
    "NO CONFUNDIR CON EL TÉRMINO \"CAMINATA\" UTILIZADO PARA LA LOCOMOCIÓN INTENCIONADA PARA LLEGAR A ALGÚN SITIO O PARA EL RECREO, EL ACONDICIONAMIENTO FÍSICO O LA COMPETICIÓN."@es,
    "TERMEN SKA INTE BLANDAS IHOP MED 'GÅENDE' SOM ANVÄNDS FÖR ATT MÅLMEDVETET GÅ TILL EN VISS PLATS ELLER SOM MOTION, TÄVLING ELLER FRITIDSAKTIVITET."@sv;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "CAPACITÉ DE MARCHER"@fr, "FORFLYTNINGSEVNE"@no, "GÅNGFÖRMÅGA"@sv,
    "GEBĖJIMAS VAIKŠČIOTI"@lt, "GEHVERMÖGEN"@de, "GÖNGUGETA"@is, "HABILIDAD PARA CAMINAR"@es,
    "JÁRÓKÉPESSÉG"@hu, "KÄVELYKYKY"@fi, "LOCOMOȚIE"@ro, "LOKOMOCE"@cs, "LOOPVAARDIGHEID"@nl,
    "WALKING ABILITY"@en, "ZMOŽNOST HOJE"@sl, "ΙΚΑΝΟΤΗΤΑ ΒΑΔΙΣΜΑΤΟΣ"@el;
  skos:altLabel "BEVEGELSESEVNE"@no, "CAPACIDAD DE CAMINAR"@es, "FÖRFLYTTNING"@sv, "GEBĖJIMAS JUDĖTI IŠ VIENOS VIETOS Į KITĄ"@lt,
    "GEHVERMOEGEN"@de, "JUDĖJIMAS"@lt, "KOERPERLICHE FORTBEWEGUNG"@de, "KÖRPERLICHE FORTBEWEGUNG"@de,
    "LOCOMOCIÓN"@es, "LOCOMOTION"@en, "LOKOMOTION"@de, "MOBILITET"@sv, "ΜΕΤΑΚΙΝΗΣΗ"@el;
  skos:historyNote "TERM CREATED JUNE 2005. PREVIOUSLY THE TERM 'WALKING' WOULD HAVE BEEN USED. TERM RELABELLED JUNE 2017. PRIOR TO THIS THE TERM 'LOCOMOTION' WOULD HAVE BEEN USED."@en,
    "TERME CRÉÉ EN JUIN 2005. AUPARAVANT LE TERME 'MARCHE' ÉTAIT UTILISÉ. RE-LABELLISÉ EN JUIN 2017. AVANT CE TERME, 'LOCOMOTION' ÉTAIT UTILISÉ."@fr,
    "TERMEN SKAPADES I JUNI 2005. INNAN DESS KAN 'GÅENDE' HA ANVÄNTS."@sv, "TERMINAS SUKURTAS 2005 M. BIRŽELIO MĖN. ANKSČIAU BUVO NAUDOJAMAS TERMINAS \"VAIKŠČIOJIMAS\". TERMINAS PERVADINTAS 2017 M. BIRŽELIO MĖN. PRIEŠ TAI BUVO NAUDOJAMAS TERMINAS \"JUDĖJIMAS\"."@lt,
    "TÉRMINO CREADO EN JUNIO DE 2005. ANTERIORMENTE SE UTILIZABA EL TÉRMINO \"CAMINATA\". TÉRMINO RECATALOGADO EN JUNIO DE 2017. ANTES SE UTILIZABA EL TÉRMINO \"LOCOMOCIÓN\"."@es;
