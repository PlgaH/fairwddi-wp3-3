<https://elsst.cessda.eu/id/6/fbf1de52-ba32-439a-94e4-1249934751b6> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/fbf1de52-ba32-439a-94e4-1249934751b6>;
  skos:definition "ARBEID UTFØRT AV BARN I SKOLEALDER, VANLIGVIS DELTID"@no, "ARBETE SOM UTFÖRS AV BARN I SKOLÅLDERN, VANLIGTVIS PÅ DELTID."@sv,
    "COPII DE VÂRSTĂ ȘCOLARĂ CARE MUNCESC, DE OBICEI CU JUMĂTATE DE NORMĂ. ACOLO UNDE ATENȚIA ESTE PE EXPLOATAREA MUNCII COPIILOR, FOLOSITȚI ”EXPLOATAREA COPIILOR PRIN MUNCĂ”."@ro,
    "KOULUIKÄISTEN LASTEN JA NUORTEN VAPAAEHTOINEN, YLEENSÄ OSA-AIKAINEN TYÖNTEKO."@fi,
    "MOKYKLINIO AMŽIAUS VAIKŲ ATLIEKAMAS DARBAS, DAŽNIAUSIAI NE VISĄ DARBO DIENĄ."@lt,
    "TRABAJO REALIZADO POR NIÑOS EN EDAD ESCOLAR, POR LO GENERAL A TIEMPO PARCIAL"@es,
    "TRAVAIL EFFECTUÉ PAR DES ENFANTS D'ÂGE SCOLAIRE, NORMALEMENT À TEMPS PARTIEL. SI L'ACCENT EST MIS SUR L'EXPLOITATION DES ENFANTS TRAVAILLEURS, UTILISEZ 'EXPLOITATION DU TRAVAIL DES ENFANTS'."@fr,
    "WEIT GEFASSTER BEGRIFF FÜR ARBEIT, DIE DURCH KINDER IM SCHULPFLICHTIGEN ALTER VERRICHTET WIRD, IN DER REGEL IN TEILZEIT."@de,
    "WERK DAT WORDT UITGEVOERD DOOR KINDEREN IN DE SCHOOLGAANDE LEEFTIJD, MEESTAL IN DEELTIJD"@nl,
    "WORK CARRIED OUT BY CHILDREN OF SCHOOL AGE, USUALLY PART-TIME"@en;
  skos:scopeNote "WHERE THE EMPHASIS IS ON THE EXPLOITATION OF CHILD WORKERS USE 'EXPLOITATION OF CHILD LABOUR'."@en,
    "ANVÄND 'UTNYTTJANDE AV BARNARBETE' NÄR FOKUS LIGGER PÅ UTNYTTJANDE AV BARNARBETARE."@sv,
    "BEI BETONUNG AUF AUSBEUTUNG DER ARBEITSLEISTUNG VON KINDERN BITTE DEN ENGEREN BEGRIFF 'KINDERARBEIT (AUSBEUTUNG)' VERWENDEN."@de,
    "CUANDO SE BUSCA ENFATIZAR LA EXPLOTACIÓN DE NIÑOS TRABAJADORES, UTILIZAR EL TÉRMINO \"EXPLOTACIÓN DE MANO DE OBRA INFANTIL\"."@es,
    "HVIS DET VIKTIGSTE ER UTNYTTELSEN AV BARNEARBEIDERE, BRUK TERMEN 'UTNYTTELSE AV BARNEARBEID'."@no,
    "JOS KYSE ON LAPSITYÖVOIMAN VÄÄRINKÄYTÖSTÄ, KÄYTÄ TERMIÄ 'LAPSITYÖVOIMAN HYVÄKSIKÄYTTÖ'."@fi,
    "QUAND L'ACCENT EST MIS SUR L'EXPLOITATION DES ENFANTS TRAVAILLEURS, UTILISER 'EXPLOITATION DU TRAVAIL DES ENFANTS'"@fr,
    "WAARBIJ DE NADRUK LIGT OP DE UITBUITING VAN KINDERARBEIDERS DOOR MIDDEL VAN 'UITBUITING VAN KINDERARBEID'."@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
