<https://elsst.cessda.eu/id/6/55bc754d-21df-4326-9dd5-af5950905358> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/55bc754d-21df-4326-9dd5-af5950905358>;
  skos:definition "ASMENS ARBA GRUPĖS ĮGYTAS DARBO LAIPSNIS, PAREIGOS AR STATUSAS."@lt,
    "DE RANG, POSITIE OF STATUS VAN EEN INDIVIDU OF GROEP"@nl, "EMPLOYMENT RANK, POSITION OR STATUS ACHIEVED BY AN INDIVIDUAL OR GROUP"@en,
    "EN INDIVID ELLER GRUPPS YRKESMÄSSIGA RANG, POSITION ELLER STATUS."@sv, "POSISJON ELLER STATUS SOM ER OPPNÅDD AV ET INDIVID ELLER EN GRUPPE."@no,
    "RANG, POSITION ODER STATUS EINES INDIVIDUUMS ODER EINER GRUPPE AM ARBEITSPLATZ. NICHT MIT 'STELLUNG IM ERWERBSLEBEN' VERWECHSELN."@de,
    "RANG, POSITION OU NIVEAU DE TRAVAIL QU'OCCUPE UNE PERSONNE OU UN GROUPE DE PERSONNES. NE PAS CONFONDRE AVEC 'STATUT DANS L'EMPLOI'."@fr,
    "RANGO LABORAL, POSICIÓN O ESTATUS ALCANZADO POR UN INDIVIDUO O GRUPO."@es, "RANGUL, POZIȚIA SAU STATUTUL UNUI INDIVID SAU AL UNUI GRUP PE PIAȚA FORȚEI DE MUNCĂ. A NU SE CONFUNDA CU 'CATEGORII PROFESIONALE'."@ro,
    "YKSILÖN TAI RYHMÄN ASEMA TAI STATUS TYÖSSÄ TAI AMMATISSA."@fi, "ΕΠΑΓΓΕΛΜΑΤΙΚΗ ΒΑΘΜΙΔΑ, ΘΕΣΗ Ή ΙΔΙΟΤΗΤΑ ΠΟΥ ΕΧΕΙ ΑΠΟΚΤΗΘΕΙ ΑΠΟ ΕΝΑ ΑΤΟΜΟ Ή ΜΙΑ ΟΜΑΔΑ. ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΕ ΜΕ ΤΗ 'ΘΕΣΗ ΣΤΗΝ ΑΠΑΣΧΟΛΗΣΗ'"@el;
  skos:scopeNote "BLANDA INTE IHOP TERMEN MED 'TJÄNSTESTÄLLNING'."@sv, "DO NOT CONFUSE WITH 'STATUS IN EMPLOYMENT'."@en,
    "MÅ IKKE FORVEKSLES MED ”STILLINGSSTATUS”."@no, "NEPAINIOTI SU „UŽIMTUMO STATUSAS“."@lt,
    "NIET TE VERWARREN MET 'STATUS IN DIENSTVERBAND'"@nl, "NO CONFUNDIR CON EL TÉRMINO \"CATEGORÍA LABORAL\"."@es,
    "VASTAA LÄHINNÄ TILASTOKESKUKSEN AMMATTILUOKITUKSEN (1-9) MUKAISTA ASEMAA. EI TULE SEKOITTAA TERMIIN 'AMMATTIASEMA'."@fi;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
