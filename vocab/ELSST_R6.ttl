<https://elsst.cessda.eu/id/6/f3f48cd8-ed94-4eb5-b221-af56c3d725d9> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/f3f48cd8-ed94-4eb5-b221-af56c3d725d9>;
  skos:definition "ANVÄNDS FÖR EN- ELLER FLERDAGSBESÖK ORGANISERADE AV SKOLOR."@sv,
    "BRUK OM OPPHOLD ELLER DAGSBESØK ORGANISERT AV SKOLER."@no, "COVERS RESIDENTIAL OR DAY VISITS ORGANIZED BY SCHOOLS ONLY"@en,
    "DIESER BEGRIFF BEZIEHT SICH AUF EIN- ODER MEHRTÄGIGE SCHULAUSFLÜGE."@de, "ESTE TÉRMINO ABARCA ÚNICAMENTE VISITAS RESIDENCIALES O DE UN DÍA ORGANIZADAS POR LAS ESCUELAS"@es,
    "HEEFT BETREKKING OP RESIDENTIËLE OF DAGBEZOEKEN DIE ALLEEN DOOR SCHOLEN WORDEN GEORGANISEERD"@nl,
    "PENTRU VIZITE LA ȘCOALĂ SAU EXCURSII DE O ZI ORGANIZATE DE ȘCOALĂ. PENTRU VACANȚE EDUCAȚIONALE PENTRU PUBLICUL LARG FOLOSIȚI 'VACANȚE EDUCAȚIONALE'. PENTRU TRANSPORTUL LA ȘI DE LA ȘCOALĂ FOLOSIȚI TERMENUL 'TRANSPORT PENTRU STUDENȚI'."@ro,
    "TERMINAS NAUDOJAMAS APIBUDINTI UGDOMAISIAIS TIKSLAIS ORGANIZUOJAMAS MOKYKLŲ IŠVYKAS AR EKSKURSIJAS. "@lt,
    "UTILISER POUR LES VISITES RÉSIDENTIELLES OU POUR LES EXCURSIONS D'UNE JOURNÉE ORGANISÉES PAR UNE ÉCOLE."@fr,
    "ΧΡΗΣΙΜΟΠΟΙΕΙΤΑΙ ΓΙΑ ΠΟΛΥΗΜΕΡΕΣ Ή ΗΜΕΡΗΣΙΕΣ ΕΠΙΣΚΕΨΕΙΣ ΟΡΓΑΝΩΜΕΝΕΣ ΑΠΟ ΤΑ ΣΧΟΛΕΙΑ"@el;
  skos:scopeNote "FOR EDUCATIONAL HOLIDAYS FOR THE GENERAL PUBLIC USE THE TERM 'EDUCATIONAL HOLIDAYS'. FOR TRAVEL TO AND FROM SCHOOL USE THE TERM 'STUDENT TRANSPORTATION'."@en,
    "FOR UTDANNINGSRELATERTE FERIER FOR ALLMENNBEFOLKNINGEN BRUK TERMEN 'FERIEKURS'. FOR REISER TIL OG FRA SKOLEN BRUK TERMEN 'TRANSPORT AV ELEVER OG STUDENTER'"@no,
    "FÜR NICHT VON EINER BILDUNGSEINRICHTUNG ORGANISIERTEN BILDUNGSURLAUB BITTE DEN BEGRIFF 'BILDUNGSREISEN' VERWENDEN. FÜR DEN SCHULWEG VERWENDEN SIE BITTE DEN BEGRIFF 'SCHÜLERVERKEHR'."@de,
    "PARA EL PERIODO VACACIONAL EDUCATIVO PARA EL PÚBLICO EN GENERAL, UTILIZAR EL TÉRMINO \"VACACIONES EDUCATIVAS\". PARA LOS VIAJES DE IDA Y VUELTA A LA ESCUELA, UTILIZAR EL TÉRMINO \"TRANSPORTE DE ESTUDIANTES\"."@es,
    "VISUOMENEI SKIRTOMS EDUKACINĖMS ATOSTOGOMS APIBŪDINTI NAUDOKITE TERMINĄ „UGDOMOSIOS ATOSTOGOS“. KELIAVIMUI IŠ IR Į MOKYKLĄ NAUDOKITE TERMINĄ „MOKINIŲ VEŽIMAS“."@lt,
    "VOOR EDUCATIEVE VAKANTIES VOOR HET GROTE PUBLIEK WORDT DE TERM 'EDUCATIEVE VAKANTIES' GEBRUIKT. VOOR REIZEN VAN EN NAAR SCHOOL WORDT DE TERM 'STUDENTENVERVOER' OF 'LEERLINGENVERVOER' GEBRUIKT"@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "EDUCATIONAL VISITS"@en, "EKSKURSJONER"@no, "EXCURSIES (ONDERWIJS)"@nl,
    "IZOBRAŽEVALNA EKSKURZIJA"@sl, "NÁMSHEIMSÓKNIR"@is, "OPINTOVIERAILUT"@fi, "ŠKOLNÍ EXKURZE"@cs,
    "STUDIEBESÖK"@sv, "STUDIENFAHRTEN"@de, "TANULMÁNYI LÁTOGATÁS"@hu, "UGDOMOSIOS IŠVYKOS"@lt,
    "VISITAS EDUCATIVAS"@es, "VISITES SCOLAIRES"@fr, "VIZITE EDUCAȚIONALE"@ro, "ΕΚΠΑΙΔΕΥΤΙΚΕΣ ΕΠΙΣΚΕΨΕΙΣ"@el;
