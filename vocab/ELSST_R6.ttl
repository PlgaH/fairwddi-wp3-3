<https://elsst.cessda.eu/id/6/bcd41d96-7e0d-45dd-b2ae-5354a1672e23> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/bcd41d96-7e0d-45dd-b2ae-5354a1672e23>;
  skos:definition "ABARCA TANTO EL USO COMO LA PROPIEDAD DE LOS VEHÍCULOS A MOTOR"@es,
    "APIMA MOTORINIŲ TRANSPORTO PRIEMONIŲ NUOSAVYBĘ IR NAUDOJIMĄ"@lt, "BEINHALTET SOWOHL DIE NUTZUNG VON, ALS AUCH DAS EIGENTUM AN FAHRZEUGEN."@de,
    "COUVRE À LA FOIS L'UTILISATION ET LA PROPRIÉTÉ DES VÉHICULES À MOTEUR"@fr, "COVERS BOTH THE USE AND OWNERSHIP OF MOTOR VEHICLES"@en,
    "DEKKER BÅDE BRUK AV OG EIERSKAP TIL MOTORKJØRETØY"@no, "GÄLLER BÅDE ANVÄNDNING OCH ÄGANDE AV MOTORFORDON."@sv,
    "HEEFT BETREKKING OP ZOWEL HET GEBRUIK ALS DE EIGENDOM VAN MOTORVOERTUIGEN"@nl, "SE POATE REFERI ȘI LA PROPRIETARI AI VEHICULELOR CU MOTOR"@ro,
    "Ο ΟΡΟΣ ΚΑΛΥΠΤΕΙ ΤΗ ΧΡΗΣΗ ΚΑΙ ΤΗΝ ΚΤΗΣΗ ΜΗΧΑΝΟΚΙΝΗΤΩΝ ΟΧΗΜΑΤΩΝ"@el;
  skos:scopeNote "ANVÄND OM MÖJLIGT EN MER SPECIFIK TERM, T.EX. 'BILAR', 'MOTORCYKLAR', 'VÄGFORDON' OSV."@sv,
    "BITTE VERWENDEN SIE, WENN MÖGLICH, EINEN GENAUEREN BEGRIFF, Z.B. 'AUTOS', 'MOTORRÄDER', 'STRASSENFAHRZEUGE' ETC."@de,
    "BRUK EN MER SPESIFIKK TERM OM MULIG F.EKS 'BILER', 'MOTORSYKLER', 'VEIKJØRETØY' OSV."@no,
    "EN LO POSIBLE, UTILIZAR UN TÉRMINO MÁS ESPECÍFICO, POR EJEMPLO, \"COCHES\", \"MOTOCICLETAS\", \"VEHÍCULOS DE CARRETERA\", ETC."@es,
    "INDIEN MOGELIJK EEN MEER SPECIFIEKE TERM GEBRUIKEN, BIJVOORBEELD 'AUTO'S', 'MOTORFIETSEN', 'WEGVOERTUIGEN', ENZ."@nl,
    "JEIGU ĮMANOMA, NAUDOKITE KONKRETESNĮ  TERMINĄ, PVZ.: „AUTOMOBILIAI“, „MOTOCIKLAI“, „KELIŲ TRANSPORTO PRIEMONĖS“ IR PAN."@lt,
    "USE A MORE SPECIFIC TERM IF POSSIBLE E.G. 'CARS', 'MOTORCYCLES', 'ROAD VEHICLES', ETC."@en,
    "UTILISEZ UN TERME PLUS SPÉCIFIQUE SI POSSIBLE E.G. 'VOITURES', 'MOTOCYCLETTES', 'VÉHICULES ROUTIERS', ETC."@fr;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
