<https://elsst.cessda.eu/id/6/9211920d-99ef-4d2b-9b9f-a90c06fda560> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/9211920d-99ef-4d2b-9b9f-a90c06fda560>;
  skos:definition "ACOPERĂ ROLURILE PE CARE LE DEȚIN PĂRINȚII ÎN CREȘTEREA ȘI EDUCAȚIA COPIILOR. PENTRU A EXPRIMA RESPONSABILITATEA LEGALĂ A PARINȚILOR FAȚĂ DE COPII A SE FOLOSI TERMENUL DE 'RESPONSABILITATE PARENTALĂ'."@ro,
    "APIMA SOCIALINĮ, EMOCINĮ IR KT. TĖVŲ VAIDMENĮ."@lt, "DEKKER DEN SOSIALE, FØLELSESMESSIGE OG LIGNENDE ROLLEN TIL FORELDRE."@no,
    "DEZE TERM HEEFT BETREKKING OP HET SOCIALE, EMOTIONELE, ENZ. ROL VAN DE OUDERS"@nl,
    "DIESER BEGRIFF BESCHREIBT DIE SOZIALE, EMOTIONALE, ETC. ROLLE DER ELTERN."@de, "ESTE TÉRMINO ABARCA EL PAPEL DE LOS PADRES A NIVEL SOCIAL, EMOCIONAL, ETC."@es,
    "KATTAA SOSIAALISIIN, YHTEISKUNNALLISIIN JA EMOTIONAALISET ASPEKTEIHIN LIITTYVÄT VANHEMPAIN ROOLIT"@fi,
    "OMFATTAR FÖRÄLDRARS SOCIALA, KÄNSLOMÄSSIGA M.M. ROLL."@sv, "TERME À UTILISER POUR DÉSIGNER LE RÔLE SOCIAL, ÉMOTIONNEL, ETC. DES PARENTS."@fr,
    "THIS TERM COVERS THE SOCIAL, EMOTIONAL, ETC. ROLE OF PARENTS."@en, "ΚΑΛΥΠΤΕΙ ΤΟΝ ΚΟΙΝΩΝΙΚΟ,ΣΥΝΑΙΣΘΗΜΑΤΙΚΟ, ΚΛΠ., ΡΟΛΟ ΤΩΝ ΓΟΝΕΩΝ"@el;
  skos:scopeNote "ANVÄND TERMEN 'FÖRÄLDRAANSVAR' FÖR FÖRÄLDRARS JURIDISKA ANSVAR FÖR ETT BARN."@sv,
    "FOR A PARENT'S LEGAL RESPONSIBILITY FOR A CHILD USE THE TERM 'PARENT RESPONSIBILITY'."@en,
    "FOR EN FORELDER SITT JURIDISKE ANSVAR FOR ET BARN BRUK TERMEN 'FORELDREANSVAR'"@no,
    "FÜR DIE RECHTLICHE VERANTWORTUNG EINES ELTERNTEILS FÜR EIN KIND BITTE DEN BEGRIFF \"ELTERLICHE VERANTWORTUNG\" VERWENDEN"@de,
    "PARA REFERIRSE A LA RESPONSABILIDAD LEGAL DE UN PROGENITOR SOBRE UN HIJO UTILIZAR EL TÉRMINO \"RESPONSABILIDAD PARENTAL\"."@es,
    """POUR DÉSIGNER LA RESPONSABILITÉ LÉGALE D'UN PARENT À L'ÉGARD D'UN ENFANT, UTILISER LE TERME 'RESPONSABILITÉ PARENTALE'
"""@fr,
    "PUHUTTAESSA VANHEMPIEN VASTUUSTA LAPSESTA LAILLISESSA MIELESSÄ, KÄYTÄ TERMIÄ 'VANHEMPIEN VASTUU'."@fi,
    "TĖVŲ TEISINEI ATSAKOMYBEI UŽ VAIKĄ APIBŪDINTI NAUDOKITE TERMINĄ „TĖVŲ ATSAKOMYBĖ“. "@lt,
    "VOOR DE WETTELIJKE AANSPRAKELIJKHEID VAN EEN OUDER VOOR EEN KIND WORDT DE TERM 'OUDERLIJK GEZAG' GEBRUIKT"@nl,
    "ΓΙΑ ΤΗΝ ΝΟΜΙΚΗ ΕΥΘΥΝΗ ΓΟΝΕΑ ΠΡΟΣ ΤΟ ΠΑΙΔΙ ΧΡΗΣΙΜΟΠΟΙΗΣΤΕ ΤΟΝ ΟΡΟ \"ΓΟΝΙΚΗ ΕΥΘΥΝΗ\""@el;
