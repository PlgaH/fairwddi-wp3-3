<https://elsst.cessda.eu/id/6/11b817d2-80e5-4109-bb48-7985642809a0> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/11b817d2-80e5-4109-bb48-7985642809a0>;
  skos:definition "ADMINISTRATIVA OCH STRUKTURELLA ASPEKTER PÅ EN UTBILDNING, SNARARE ÄN ÄMNESMÄSSIGT INNEHÅLL OCH METODASPEKTER."@sv,
    "ASPECTELE ADMINISTRATIVE ȘI STRUCTURALE ALE UNUI CURS ÎN AFARA SUBIECTULUI SAU CONȚINUTULUI SAU  A METODOLOGIEI DE PREDARE. PENTRU SUBIECTELE CURSURILOR FOLOSIȚI 'DOMENII DE STUDIU' SAU UNUL DINTRE TERMENII SĂI SPECIFICI (NARROW TERMS). PENTRU ASPECTELE METODOLOGICE ALE PREDĂRII VEDEȚI 'METODE DIDACTICE'."@ro,
    "ASPECTS ADMINISTRATIFS ET STRUCTURELS DE COURS D'ENSEIGNEMENT, PLUTÔT QUE LEUR CONTENU. POUR LE CONTENU DE COURS D'ENSEIGNEMENT, UTILISER LE TERME 'DOMAINES D'ÉTUDE' ET SES TERMES SPÉCIFIQUES."@fr,
    "BEZIEHT SICH AUF DIE VERWALTUNGS- UND STRUKTURELLEN ASPEKTE VON KURSEN, WENIGER AUF IHREN THEMATISCHEN INHALT ODER METHODISCHE FRAGEN."@de,
    "DE ADMINISTRATIEVE EN STRUCTURELE ASPECTEN VAN DE CURSUS EN NIET ZOZEER DE INHOUDELIJKE OF METHODOLOGISCHE ASPECTEN VAN HET ONDERWERP"@nl,
    "DE ADMINISTRATIVE ASPEKTENE VED KURS OG IKKE INNHOLD ELLER METODE."@no, "EL TÉRMINO SE REFIERE A LOS ASPECTOS ADMINISTRATIVOS Y ESTRUCTURALES DEL CURSO MÁS QUE AL CONTENIDO DE LA MATERIA O SUS ASPECTOS METODOLÓGICOS."@es,
    "OPINNOT, OPINTOJAKSOT JA -KURSSIT HALLINNOLLISESTA JA RAKENTEELLISESTA NÄKÖKULMASTA."@fi,
    "THE ADMINISTRATIVE AND STRUCTURAL ASPECTS OF THE COURSE RATHER THAN THE SUBJECT CONTENT OR METHODOLOGICAL ASPECTS"@en,
    "Ο ΟΡΟΣ ΚΑΛΥΠΤΕΙ ΤΗ ΔΙΟΙΚΗΤΙΚΗ ΚΥΡΙΩΣ ΔΟΜΗ ΤΩΝ ΜΑΘΗΜΑΤΩΝ ΚΑΙ ΟΧΙ ΤΟ ΠΕΡΙΕΧΟΜΕΝΟ Ή ΤΗ ΜΕΘΟΔΟΛΟΓΙΑ. ΓΙΑ ΤΟ ΠΕΡΙΕΧΟΜΕΝΟ ΣΠΟΥΔΩΝ ΒΛ.'ΠΕΔΙΑ ΣΠΟΥΔΩΝ' Ή ΣΧΕΤΙΚΟΥΣ ΟΡΟΥΣ.ΓΙΑ ΤΗ ΜΕΘΟΔΟΛΟΓΙΑ ΤΩΝ ΑΝΑΛΥΤΙΚΩΝ ΠΡΟΓΡΑΜΜΑΤΩΝ ΒΛ. 'ΜΕΘΟΔΟΙ ΔΙΔΑΣΚΑΛΙΑΣ'."@el,
    "TERMINAS APIMA ADMINISTRACINIUS IR STRUKTŪRINIUS KURSŲ ASPEKTUS, O NE TURINĮ AR METODOLOGIJĄ."@lt;
  skos:scopeNote "ANVÄND TERMEN ”STUDIEINRIKTNINGAR” ELLER DESS UNDERKATEGORIER FÖR ÄMNESMÄSSIGT INNEHÅLL OCH ”UNDERVISNINGSMETODER” FÖR METODASPEKTER PÅ UTBILDNINGAR."@sv,
    "FOR INNHOLD BRUK TERMEN ”STUDIERETNING” ELLER EN AV UNDERTERMENE. FOR METODE SE ”UNDERVISNINGSMETODE” ."@no,
    "FOR SUBJECT CONTENT OF EDUCATIONAL COURSES USE THE TERM 'FIELDS OF STUDY' OR ITS NARROWER CONCEPTS. FOR METHODOLOGICAL ASPECTS OF EDUCATIONAL COURSES SEE 'TEACHING METHODS'."@en,
    "FÜR DEN THEMATISCHEN INHALT VON KURSEN BITTE DEN BEGRIFF 'FACHGEBIETE (AUSBILDUNG)' ODER EINEN DER ENGEREN BEGRIFFE BENUTZEN. FÜR ASPEKTE DER METHODIK VON KURSEN BITTE DEN BEGRIFF 'LEHRMETHODEN' VERWENDEN."@de,
    "KOULUTUKSEN SISÄLLÖSTÄ KÄYTETÄÄN ASIASANAA 'KOULUTUSALAT' TAI SEN SUPPEAMPIA TERMEJÄ. KOULUTUKSEN METODOLOGISESTA NÄKÖKULMASTA KÄYTETÄÄN ASIASANAA 'KOULUTUSMENETELMÄT, OPETUSMENETELMÄT JA OPPIMISMENETELMÄT' TAI SEN SUPPEAMPIA TERMEJÄ."@fi,
    "PARA EL CONTENIDO TEMÁTICO DE LOS CURSOS EDUCATIVOS, UTILIZAR EL TÉRMINO \"ÁREAS DE FORMACIÓN\" O SUS CONCEPTOS MÁS RESTRINGIDOS. PARA LOS ASPECTOS METODOLÓGICOS DE LOS CURSOS EDUCATIVOS, VER EL TÉRMINO \"MÉTODOS DE ENSEÑANZA\"."@es,
    "POUR UN SUJET SUR LE CONTENU DES COURS ÉDUCATIFS, UTILISER LE TERME 'DOMAINES D’ÉTUDES' OU SON SON TERME INFÉRIEUR. POUR LES ASPECTS METHODOLOGIQUES DES COURS EDUCATIFS, VOIR 'MÉTHODES PÉDAGOGIQUES'."@fr,
    "UGDYMO KURSŲ DALYKINIAM TURINIUI APIBŪDINTI NAUDOKITE TERMINĄ „STUDIJŲ KRYPTYS“ ARBA SIAURESNĘ TERMINO SĄVOKĄ. APIE METODOLOGINIUS UGDYMO KURSŲ ASPEKTUS ŽR. TERMINĄ „MOKYMO METODAI“."@lt,
    "VOOR DE INHOUD VAN DE VAKKEN VAN DE CURSUSSEN WORDT DE TERM 'STUDIEGEBIEDEN' GEBRUIKT. VOOR METHODOLOGISCHE ASPECTEN VAN ONDERWIJSCURSUSSEN, ZIE 'ONDERWIJSMETHODEN'"@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "COURS (ENSEIGNEMENT)"@fr, "CURSOS EDUCATIVOS"@es, "CURSURI EDUCAȚIONALE"@ro,
