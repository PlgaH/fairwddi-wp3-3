<https://elsst.cessda.eu/id/6/a240475a-711e-48ce-9f48-e4f172259040> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/a240475a-711e-48ce-9f48-e4f172259040>;
  skos:definition "ACEST TERMEN SE FOLOSEȘTE PENTRU DATE DESPRE PROBLEME GENERALE DE SĂNĂTATE. PENTRU BOLI SPECIFICE FOLOSIȚI „BOLI”. PENTRU DATE DESPRE SĂNĂTATE ȘI BUNĂSTARE ÎN GENERAL FOLOSIȚI „SĂNĂTATE”"@ro,
    "ASIASANAA KÄYTETÄÄN KÄSITELTÄESSÄ TERVEYDELLISIÄ ONGELMIA , HÄIRIÖITÄ JA SAIRAUKSIA YLEISELLÄ TASOLLA."@fi,
    "CE TERME EST UTILISÉ POUR LES DONNÉES SUR LA MALADIE EN GÉNÉRAL."@fr, "DEZE TERM WORDT GEBRUIKT VOOR GEGEVENS OVER ALGEMENE GEZONDHEIDSPROBLEMEN"@nl,
    "ESTE TÉRMINO SE UTILIZA PARA DATOS RELACIONADOS CON LA MALA SALUD GENERAL."@es, "TERMEN ANVÄNDS FÖR DATA OM ALLMÄN OHÄLSA."@sv,
    "TERMEN BENYTTES OM DATA FOR GENERELL DÅRLIG HELSE"@no, "THIS TERM IS USED FOR DATA ON GENERAL ILL HEALTH."@en,
    "ΑΥΤΟΣ Ο ΟΡΟΣ ΧΡΗΣΙΜΟΠΟΙΕΙΤΑΙ ΓΙΑ ΔΕΔΟΜΕΝΑ ΠΟΥ ΑΦΟΡΟΥΝ ΓΕΝΙΚΑ ΤΗΝ ΚΑΚΗ ΥΓΕΙΑ. '"@el,
    "DIESER BEGRIFF WIRD FÜR DATEN ZU KRANKHEIT IM ALLGEMEINEN VERWENDET. FÜR DATEN ZU EINZELNEN KRANKEITEN VERWENDEN SIE BITTE DEN BEGRIFF 'KRANKHEITEN' ODER EINEN UNTERBEGRIFF VON 'KRANKHEITEN'. FÜR DATEN ZUR ALLGEMEINEN GESUNDHEIT ODER ZUM ALLGEMEINEN WOHLBEFINDEN VERWENDEN SIE BITTE DEN BEGRIFF 'GESUNDHEIT'. FÜR DATEN ZU MORBIDITÄT BENUTZEN SIE BITTE DEN BEGRIFF  'MORBIDITÄTSRATE'."@de,
    "DUOMENIMS APIE KONKREČIAS LIGAS APIBŪDINTI NAUDOKITE TERMINĄ „LIGOS“ ARBA SIAURESNĮ TERMINĄ. DUOMENIMS APIE BENDRĄJĄ SVEIKATĄ IR GEROVĘ NAUDOKITE TERMINĄ „SVEIKATA“. STATISTIKAI APIE SERGAMUMĄ NAUDOKITE TERMINĄ „SERGAMUMO RODIKLIS“."@lt;
  skos:scopeNote "ANVÄND TERMEN 'SJUKDOM' ELLER DESS UNDERKATEGORIER FÖR DATA OM SPECIFIKA SJUKDOMAR. ANVÄND 'HÄLSA' FÖR DATA OM ALLMÄN HÄLSA OCH VÄLBEFINNANDE."@sv,
    "DUOMENIMS APIE KONKREČIAS LIGAS APIBŪDINTI NAUDOKITE TERMINĄ „LIGOS“ ARBA  SIAURESNĮ TERMINĄ. DUOMENIMS APIE BENDRĄJĄ SVEIKATĄ IR GEROVĘ NAUDOKITE TERMINĄ „SVEIKATA“."@lt,
    "ERITYISIÄ SAIRAUKSIA KUVATAAN TERMILLÄ 'TAUDIT' TAI TARKEMMILLA TERMEILLÄ. YLEISTÄ TERVEYDENTILAA JA HYVINVOINTIA KUVATAAN TERMILLÄ 'TERVEYDENTILA'."@fi,
    " FOR DATA ON SPECIFIC DISEASES USE THE TERM 'DISEASES' OR ITS NARROWER CONCEPTS. FOR DATA ON GENERAL HEALTH AND WELL-BEING USE THE TERM 'HEALTH'. FOR STATISTICS ON MORBIDITY USE 'MORBIDITY RATE'."@en,
    "POUR DES DONNÉES SUR DES MALADIES SPÉCIFIQUES, UTILISER LE TERME \"MALADIES\" OU SES TERMES SPÉCIFIQUES. POUR DES DONNÉES GÉNÉRALES SUR LA SANTÉ, UTILISER LE TERME GÉNÉRIQUE \"SANTÉ\". POUR LES STATISTIQUES SUR LA MORBIDITÉ, UTILISER \"TAUX DE MORBIDITÉ\"."@fr,
    "ΓΙΑ ΔΕΔΟΜΕΝΑ ΣΧΕΤΙΚΑ ΜΕ ΣΥΓΚΕΚΡΙΜΕΝΕΣ ΑΣΘΕΝΕΙΕΣ ΧΡΗΣΙΜΟΠΟΙΗΣΤΕ ΤΟΝ ΟΡΟ 'ΠΑΘΗΣΕΙΣ' Ή ΤΙΣ ΠΙΟ ΣΤΕΝΕΣ ΕΝΝΟΙΕΣ ΤΟΥ. ΓΙΑ ΔΕΔΟΜΕΝΑ ΣΧΕΤΙΚΑ ΜΕ ΤΗ ΓΕΝΙΚΗ ΥΓΕΙΑ ΚΑΙ ΕΥΕΞΙΑ ΧΡΗΣΙΜΟΠΟΙΕΙΤΕ ΤΟΝ ΟΡΟ 'ΥΓΕΙΑ'. ΓΙΑ ΣΤΑΤΙΣΤΙΚΑ ΣΧΕΤΙΚΑ ΜΕ ΤΗ ΝΟΣΗΡΟΤΗΤΑ ΧΡΗΣΙΜΟΠΟΙΕΙΤΕ ΤΟΝ ΟΡΟ 'ΔΕΙΚΤΗ ΝΟΣΗΡΟΤΗΤΑΣ'."@el,
    "PARA DATOS RELACIONADOS CON ENFERMEDADES ESPECÍFICAS, UTILIZAR EL TÉRMINO \"ENFERMEDADES\" O SUS CONCEPTOS MÁS LIMITADOS. PARA DATOS RELACIONADOS CON LA SALUD GENERAL Y EL BIENESTAR, UTILIZAR EL TÉRMINO \"SALUD\". PARA LAS ESTADÍSTICAS SOBRE MORBILIDAD, UTILIZAR \"TASA DE MORBILIDAD\"."@es,
    "FOR DATA OM SPESIFIKKE SYKDOMMER, BRUK BEGREPET 'SYKDOMMER' ELLER DETS MER SPESIFIKKE UNDERBEGREPER. FOR DATA OM GENERELL HELSE OG VELVÆRE, BRUK BEGREPET 'HELSE'. FOR STATISTIKK OM SYKELIGHET, BRUK 'SYKELIGHETSRATE'."@no,
    "GEBRUIK VOOR GEGEVENS OVER SPECIFIEKE ZIEKTEN DE TERM ‘ZIEKTEN’ OF DE MEER SPECIFIEKE CONCEPTEN DAARVAN. GEBRUIK VOOR GEGEVENS OVER ALGEMENE GEZONDHEID EN WELZIJN DE TERM ‘GEZONDHEID’. GEBRUIK VOOR STATISTIEKEN OVER MORBIDITEIT DE TERM ‘MORBIDITEITSPERCENTAGE’."@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
