<https://elsst.cessda.eu/id/6/ae9096d3-1e97-4e8d-ac4e-3bc9034b99a4> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/ae9096d3-1e97-4e8d-ac4e-3bc9034b99a4>;
  skos:definition "ANVÄND TERMEN FÖR SKOLAVGÅNG FÖRE AVSLUTAD OBLIGATORISK SKOLGÅNG."@sv,
    "BRUKES FOR Å SLUTTE PÅ SKOLEN FØR AVSLUTTET OBLIGATORISK UTDANNELSE"@no, "DER BEGRIFF BEZIEHT SICH AUF DEN SCHULABGANG NACH ABSOLVIEREN DER PFLICHTSCHULZEIT."@de,
    "GEBRUIK VOOR HET VERLATEN VAN DE SCHOOL TOT HET VOLTOOIEN VAN DE LEERPLICHT"@nl,
    "KOULUNKÄYNNIN LOPETTAMINEN OPINTOJEN LOPPUUN SUORITTAMISEEN."@fi, "MOKYKLOS BAIGIMAS UŽBAIGUS PRIVALOMĄJĮ UGDYMĄ."@lt,
    "OPUSTITEV ŠOLANJA PRED ZAKONSKO PREDVIDENIM ZAKLJUČKOM OBVEZNEGA ŠOLANJA"@sl, "SE REFIERE AL ABANDONO DE LA ESCUELA EN CUALQUIER MOMENTO HASTA LA FINALIZACIÓN DE LA ENSEÑANZA OBLIGATORIA"@es,
    "USE FOR LEAVING SCHOOL UP TO COMPLETION OF COMPULSORY EDUCATION"@en;
  skos:scopeNote "ANVÄND 'AVSLUTAD GRUNDSKOLA' FÖR SKOLAVGÅNG EFTER AVSLUTAD OBLIGATORISK SKOLGÅNG."@sv,
    "DANS LE CAS DE L'ARRÊT DE L'ÉCOLE À LA FIN DE LA SCOLARITÉ OBLIGATOIRE, UTILISER LE TERME 'FIN DE L'ÉCOLE SECONDAIRE'."@fr,
    "FOR SCHOOL LEAVING UPON COMPLETION OF COMPULSORY EDUCATION, USE THE TERM 'SECONDARY SCHOOL LEAVING'. "@en,
    "FOR SKOLESLUTTING ETTER OBLIGATORISK UTDANNELSE, BRUK TERMEN 'SKOLESLUTTING I VIDEREGÅENDE SKOLE'"@no,
    "FÜR SCHULABGÄNGE JENSEITS DER PFLICHTSCHULZEIT BITTE DEN BEGRIFF 'ABSCHLUSS DER SEKUNDARBILDUNG' VERWENDEN."@de,
    "HUOMIOI MYÖS TERMI 'OPINTOJEN KESKEYTTÄMINEN'."@fi, "KALBANT APIE MOKYKLOS BAIGIMĄ BAIGUS PRIVALOMĄJĮ UGDYMĄ NAUDOTI TERMINĄ „PAGRINDINĮ IR VIDURINĮ IŠSILAVINIMĄ TEIKIANČIOS MOKYKLOS BAIGIMAS“."@lt,
    "PARA EL ABANDONO ESCOLAR AL FINALIZAR LA ENSEÑANZA OBLIGATORIA, UTILIZAR EL TÉRMINO \"FINAL DEL CICLO EDUCATIVO SECUNDARIO\". "@es,
    "VOOR SCHOOLUITVAL NA VOLTOOIING VAN DE LEERPLICHT WORDT DE TERM 'MIDDELBARE SCHOOLUITVAL' GEBRUIKT. "@nl;
