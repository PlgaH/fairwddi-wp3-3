<https://elsst.cessda.eu/id/6/becf13ae-fa53-4ccc-9830-89cf0d9d25b9> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/becf13ae-fa53-4ccc-9830-89cf0d9d25b9>;
  skos:definition "ANGST FORÅRSAKET AV EN UKJENT, INNBILT ELLER  UBESTEMT TRUSSEL."@no,
    "ANGSTZUSTAND, DER AUS EINER UNBEKANNTEN, NICHT VORHANDENEN ODER UNKONKRETEN GEFAHR RESULTIERT."@de,
    "KÄNSLA AV ORO SOM ORSAKAS AV ETT OKÄNT, INBILLAT ELLER OKLART HOT."@sv, "NERIMO JAUSMAS, KURĮ SUKELIA NEŽINOMA, ĮSIVAIZDUOJAMA AR NETIKSLI GRĖSMĖ."@lt,
    "SENS DE L’ANXIÉTÉ CAUSÉ PAR UNE MENACE INCONNUE, IMAGÉE OU IMPRÉCISE."@fr, "SENSACIÓN DE ANSIEDAD CAUSADA POR UNA AMENAZA DESCONOCIDA, IMAGINADA O INDEFINIDA."@es,
    "SENSE OF ANXIETY CAUSED BY AN UNKNOWN, IMAGINED OR IMPRECISE THREAT."@en, "ΤΟ ΑΙΣΘΗΜΑ ΑΝΗΣΥΧΙΑΣ ΠΟΥ ΠΡΟΚΑΛΕΙΤΑΙ ΑΠΟ ΜΙΑ ΓΝΩΣΤΗ, ΦΑΝΤΑΣΤΙΚΗ 'Η ΑΠΡΟΣΔΙΟΡΙΣΤΗ ΑΠΕΙΛΗ"@el;
  skos:scopeNote "ANVÄND 'RÄDSLA' FÖR ETT ÅNGESTLADDAT TILLSTÅND SOM ORSAKAS AV ETT FAKTISKT HOT."@sv,
    "FOR A STATE OF ANXIETY CAUSED BY A REAL THREAT, USE THE TERM 'FEAR'.'"@en, "FOR ANGST FORÅRSAKET AV EN REELL TRUSSEL, BRUK BEGREPET 'REDSEL'. "@no,
    "FÜR DIE DURCH EINE ECHTE GEFAHR AUSGELÖSTE ANGST VERWENDEN SIE BITTE DEN BEGRIFF 'FURCHT'."@de,
    "PARA UN ESTADO DE ANSIEDAD CAUSADO POR UNA AMENAZA REAL, UTILIZAR EL TÉRMINO \"TEMOR\"."@es,
    "POUR UN ÉTAT D'ANXIÉTÉ CAUSÉ PAR UNE VRAIE MENACE, UTILISER LE TERME 'PEUR'."@fr,
    "REALIOS GRĖSMĖS SUKELTAI NERIMO BŪSENAI APIBŪDINTI NAUDOKITE TERMINĄ „BAIMĖ“."@lt,
    "ΓΙΑ ΤΗΝ ΚΑΤΑΣΤΑΣΗ ΑΝΗΣΥΧΙΑΣ ΠΟΥ ΠΡΟΚΑΛΕΙΤΑΙ ΑΠΟ ΥΠΑΡΚΤΗ ΑΠΕΙΛΗ,ΧΡΗΣΙΜΟΠΟΙΕΙΣΤΕ ΤΟΝ ΟΡΟ 'ΦΟΒΟΣ'"@el;
