<https://elsst.cessda.eu/id/6/569f3379-d57a-48c5-850f-48ce4c1a3555> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/569f3379-d57a-48c5-850f-48ce4c1a3555>;
  skos:definition "ALLE PROSESSENE SOM ER INVOLVERT VED KOMMUNISERING AV INFORMASJON."@no,
    "DE OLIKA PROCESSER SOM INGÅR VID FÖRMEDLING AV INFORMATION."@sv, "DE VERSCHILLENDE PROCESSEN DIE BETROKKEN ZIJN BIJ DE COMMUNICATIE VAN INFORMATIE"@nl,
    "DIVERSELE PROCESE IMPLICATE ÎN COMUNICAREA INFORMAȚIEI. FOLOSIȚI UN TERMEN SPECIFIC DACĂ SE POATE."@ro,
    "ENSEMBLE DES PROCESSUS SERVANT À LA DIFFUSION D’INFORMATIONS. SI POSSIBLE, OPTER POUR UN TERME PLUS SPÉCIFIQUE."@fr,
    "INFORMAATION VÄLITTÄMISEEN LIITTYVÄT PROSESSIT."@fi, "ĮVAIRŪS INFORMACIJOS PERDAVIMO PROCESAI."@lt,
    "LOS DISTINTOS PROCESOS QUE INTERVIENEN EN LA COMUNICACIÓN DE LA INFORMACIÓN"@es,
    "THE VARIOUS PROCESSES INVOLVED IN THE COMMUNICATION OF INFORMATION"@en, "VORGÄNGE, DIE BEI DER KOMMUNIKATION VON INFORMATION ABLAUFEN."@de,
    "ΟΙ ΔΙΑΦΟΡΕΣ ΔΙΕΡΓΑΣΙΕΣ ΠΟΥ ΑΠΑΙΤΟΥΝΤΑΙ ΓΙΑ ΤΗΝ ΠΑΡΟΧΗ ΠΛΗΡΟΦΟΡΗΣΗΣ. ΧΡΗΣΙΜΟΠΟΙΗΣΤΕ ΕΝΑ ΠΙΟ ΣΥΓΚΕΚΡΙΜΕΝΟ ΟΡΟ, ΑΝ ΕΙΝΑΙ ΔΥΝΑΤΟΝ."@el;
  skos:scopeNote "ANVÄND OM MÖJLIGT EN MER SPECIFIK TERM."@sv, "JEIGU ĮMANOMA, NAUDOKITE KONKRETESNĮ TERMINĄ."@lt,
