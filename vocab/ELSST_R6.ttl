<https://elsst.cessda.eu/id/6/3a9b3735-1201-4b7f-b45c-f70fdf625782> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/3a9b3735-1201-4b7f-b45c-f70fdf625782>;
  skos:definition "ABSENȚA DE LA LOCUL DE MUNCĂ"@ro, "COUVRE UNIQUEMENT LES ABSENCES AU TRAVAIL"@fr,
    "COVERS ABSENCE FROM WORK ONLY"@en, "CUBRE ÚNICAMENTE LA AUSENCIA DEL TRABAJO"@es,
    "DEKKER KUN FRAVÆR FRA JOBB"@no, "DEKT ALLEEN AFWEZIGHEID VAN HET WERK"@nl, "DIESER BEGRIFF BEZIEHT SICH NUR AUF DIE ABWESENHEIT VOM ARBEITSPLATZ."@de,
    "GÄLLER ENDAST FRÅNVARO FRÅN ARBETET."@sv, "SUSIJĘ TIK SU NEBUVIMU DARBE."@lt, "TENTO TERMÍN V SOBĚ ZAHRNUJE POUZE ABSENCI V PRÁCI - PRO ABSENCI VE ŠKOLE UŽIJTE TERMÍN 'ŠKOLNÍ DOCHÁZKA'"@cs,
    "ΚΑΛΥΠΤΕΙ ΜΟΝΟ ΤΗΝ ΑΠΟΥΣΙΑ ΑΠΟ ΤΗΝ ΕΡΓΑΣΙΑ"@el;
  skos:scopeNote "ANVÄND 'SKOLNÄRVARO' ELLER 'SKOLK' FÖR SKOLFRÅNVARO."@sv, "FOR ABSENCE FROM SCHOOL USE 'EDUCATIONAL ATTENDANCE' or 'TRUANCY'."@en,
    "FOR FRAVÆR FRA SKOLE BRUK 'SKOLENÆRVÆR' ELLER 'SKULKING'."@no, "FÜR DIE ABWESENHEIT VOM SCHULUNTERRICHT BITTE DEN BEGRIFF 'UNENTSCHULDIGTES FEHLEN (SCHULE)' VERWENDEN."@de,
    "PARA LA AUSENCIA DE LA ESCUELA USAR \"ASISTENCIA ESCOLAR\" o \"ABSENTISMO ESCOLAR\"."@es,
