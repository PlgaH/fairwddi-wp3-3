<https://elsst.cessda.eu/id/6/38053f64-603a-4725-b606-4e687ade9aef> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/38053f64-603a-4725-b606-4e687ade9aef>;
  skos:definition "BEGRIFF BEZIEHT SICH AUF FERIENCAMPINGPLÄTZE FÜR ZELTE, WOHNWAGEN, WOHNMOBILE UND FERIENMOBILHEIME."@de,
    "COVERS HOLIDAY CAMPING SITES FOR TENTS, CAMPER VANS, TOURING CARAVANS AND STATIC CARAVANS"@en,
    "ESTE TÉRMINO ABARCA ACAMPADAS VACACIONALES PARA TIENDAS DE CAMPAÑA, AUTOCARAVANAS, CARAVANAS DE TURISMO Y CARAVANAS ESTÁTICAS"@es,
    "GÄLLER CAMPINGPLATSER FÖR TÄLT, HUSBILAR, HUSVAGNAR OCH VILLAVAGNAR."@sv, "HEEFT BETREKKING OP KAMPEERPLAATSEN VOOR TENTEN, CAMPERS, KAMPEERWAGENS, TOERCARAVANS EN STACARAVANS"@nl,
    "STED HVOR EN KAN CAMPE OG SETTE OPP TELT, BOBILER OG CAMPINGVOGNER."@no, "TERMEN FOLOSIT PENTRU LOCURILE DE CAMPING PENTRU CORTURI, RULOTE, CARAVANE TURISTICE SAU STATICE. PENTRU ZONE DE STAȚIONARE ALE CARAVANELOR DE ȚIGANI/ROMI SAU NOMAZI  FOLOSIȚI 'AMPLASAMENTE PENTRU NOMAZI'."@ro,
    "TERRAINS DE CAMPING POUR VACANCIERS DESTINÉS À ACCUEILLIR DES TENTES, DES CARAVANES ET DES CAMPING-CARS. POUR LES AIRES D’ACCUEIL DESTINÉES AUX GENS DU VOYAGE, UTILISER LE TERME “AIRES D’ACCUEIL DES GENS DU VOYAGE”."@fr,
    "ΑΥΤΟΣ Ο ΟΡΟΣ ΧΡΗΣΙΜΟΠΟΙΕΙΤΑΙ ΓΙΑ ΧΩΡΟΥΣ ΕΓΚΑΤΑΣΤΑΣΗΣ ΣΚΗΝΩΝ, ΤΡΟΧΟΣΠΙΤΩΝ, ΑΥΤΟΚΙΝΟΥΜΕΝΩΝ, ΚΑΤΑ ΤΗ ΔΙΑΡΚΕΙΑ ΔΙΑΚΟΠΩΝ. ΓΙΑ ΚΑΤΑΣΗΝΩΣΕΙΣ ΝΟΜΑΔΩΝ Ή ΤΣΙΓΓΑΝΩΝ, ΧΡΗΣΙΜΟΠΟΙΗΣΕ ΤΟΝ ΟΡΟ «ΚΑΤΑΛΥΜΑΤΑ ΤΑΞΙΔΙΩΤΩΝ»"@el,
    "ŠIS TERMINAS APIMA STOVYKLAVIETES PALAPINĖMS, KEMPERIAMS, TURISTINIAMS IR STACIONARIEMS NAMELIAMS ANT RATŲ."@lt;
  skos:scopeNote "ANVÄND TERMEN 'BOPLATSER FÖR RESANDEFOLK' FÖR CAMPINGPLATSER FÖR RESANDEFOLK OCH ROMER."@sv,
    "FOR PLASSER BRUKT AV REISENDE/SIGØYNERE BRUK TERMEN 'BOPLASS FOR REISENDE'"@no, "FOR TRAVELLER/GYPSY CAMPING SITES, USE THE TERM 'TRAVELLERS' SITES'."@en,
    "FÜR WAGEN- UND ZELTPLÄTZE FÜR REISENDE UND FAHRENDE (PAVEE ETC.) BITTE DEN BEGRIFF 'LAGERPLÄTZE FÜR REISENDE' VERWENDEN."@de,
    "KELIAUTOJŲ IR (ARBA) ROMŲ STOVYKLAVIETĖMS APIBŪDINTI VARTOKITE TERMINĄ „KELIAUTOJŲ STOVYKLOS“."@lt,
    "PARA CAMPAMENTOS DE VIAJEROS O GITANOS, UTILIZAR EL TÉRMINO \"EMPLAZAMIENTOS DE COMUNIDADES ITINERANTES\"."@es;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "CAMPING SITES"@en, "CAMPINGPLASS"@no, "CAMPINGPLATSER"@sv, "CAMPINGPLÄTZE"@de,
    "KAMPEERPLAATSEN"@nl, "KEMPING"@hu, "KEMPINGAI"@lt, "LEIRINTÄALUEET"@fi, "PROSTOR ZA KAMPIRANJE"@sl,
    "TÁBOŘIŠTĚ"@cs, "TERRAINS DE CAMPING"@fr, "TJALDSVÆÐI"@is, "ZONAS DE ACAMPADA"@es,
    "ZONE DE CAMPING"@ro, "ΚΑΤΑΣΚΗΝΩΣΕΙΣ"@el;
