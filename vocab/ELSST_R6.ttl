  skos:definition " RELATIONSHIP BREAKDOWN SHORT OF DIVORCE OR DISSOLUTION OF CIVIL PARTNERSHIP"@en,
    "DIZOLVAREA CĂSĂTORIEI, NU NEAPĂRAT ÎN SENS LEGAL."@ro, "FORHOLDSBRUDD SOM IKKE ER SKILSMISSE ELLER OPPLØSNING AV REGISTRERT PARTNERSKAP."@no,
    "PARISUHTEEN PÄÄTTYMINEN MUULLA TAVOIN KUIN AVIOEROON TAI REKISTERÖIDYSTÄ PARISUHTEESTA EROAMISEEN."@fi,
    "RUPTURA DE LA RELACIÓN SIN DIVORCIO NI DISOLUCIÓN DE LA PAREJA DE HECHO"@es, "RUPTURE D'UNE RELATION, SANS DISSOLUTION DE MARIAGE OU DE PARTENARIAT CIVIL"@fr,
    "UITSPLITSING VAN HET HUWELIJK, NIET NOODZAKELIJKERWIJS IN JURIDISCHE ZIN"@nl, "UPPLÖSNING AV EN RELATION SOM INTE ÄR SKILSMÄSSA."@sv,
    "ZERRÜTTUNG DER BEZIEHUNG OHNE SCHEIDUNG ODER AUFHEBUNG DER LEBENSPARTNERSCHAFT"@de,
    "ΛΥΣΗ ΤΗΣ ΣΧΕΣΗΣ ΣΑΝ ΔΙΑΖΥΓΙΟ Ή ΛΥΣΗ ΣΥΜΦΩΝΟΥ ΕΛΕΥΘΕΡΗΣ ΣΥΜΒΙΩΣΗΣ"@el, "SANTYKIŲ NUTRŪKIMAS PO SKYRYBŲ ARBA CIVILINĖS PARTNERYSTĖS NUTRAUKIMO."@lt;
  skos:scopeNote "HUOMIOI TERMIT 'AVIOERO' JA 'ASUMUSEROSSA ELÄVÄT', KUN VIITATAAN AVIOLIITON HAJOAMISEEN."@fi;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "DESFACEREA CĂSĂTORIEI"@ro, "FAMILJEUPPLÖSNING"@sv, "HÁZASSÁG FELBONTÁSA"@hu,
    "HJÓNABANDSSLIT"@is, "HUWELIJKSONTBINDING"@nl, "PARISUHTEEN PÄÄTTYMINEN"@fi, "PRENEHANJE RAZMERJA"@sl,
