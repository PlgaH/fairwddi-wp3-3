<https://elsst.cessda.eu/id/6/33a9c792-284b-4fe1-a57f-3ab140691e4f> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/33a9c792-284b-4fe1-a57f-3ab140691e4f>;
  skos:definition "A LEGALLY RECOGNIZED RELATIONSHIP BETWEEN ADULTS THAT CARRIES CERTAIN LEGAL RIGHTS AND OBLIGATIONS"@en,
    "AVIOLIITTO OIKEUDELLISESSA MERKITYKSESSÄ, JOKA SISÄLTÄÄ TIETTYJÄ OIKEUKSIA JA VELVOLLISUUKSIA."@fi,
    "EEN WETTELIJK ERKENDE RELATIE TUSSEN VOLWASSENEN DIE BEPAALDE WETTELIJKE RECHTEN EN PLICHTEN MET ZICH MEEBRENGT"@nl,
    "EN JURIDISK RELATION MELLAN VUXNA SOM MEDFÖR VISSA LAGLIGA RÄTTIGHETER OCH SKYLDIGHETER."@sv,
    "ET JURIDISK ANERKJENT FORHOLD MELLOM VOKSNE SOM INNEBÆRER VISSE RETTIGHETER OG PLIKTER."@no,
    "RECHTLICH ANERKANNTE BEZIEHUNG ZWISCHEN ERWACHSENEN, DIE MIT GEWISSEN RECHTEN UND PFLICHTEN EINHERGEHT."@de,
    "RELATION LÉGALEMENT RECONNUE ENTRE ADULTES QUI COMPORTE CERTAINS DROITS ET OBLIGATIONS JURIDIQUES."@fr,
    "UNA RELACIÓN LEGALMENTE RECONOCIDA ENTRE ADULTOS QUE CONLLEVA CIERTOS DERECHOS Y DEBERES LEGALES."@es,
    "TEISIŠKAI PRIPAŽĮSTAMI SANTYKIAI TARP SUAUGUSIŲJŲ, SU KURIAIS SIEJAMOS TAM TIKROS TEISĖS IR PAREIGOS."@lt;
  skos:scopeNote "DO NOT USE FOR MEASURES OF MARRIAGE RATES OR FOR THE CEREMONY OF MARRIAGE."@en,
    "EI TULE SEKOITTAA TERMEIHIN 'AVIOLIITTOJEN MÄÄRÄ', 'AVIOITUVUUSLUKU' TAI 'HÄÄT'."@fi,
    "FÜR 'HEIRATSRATE' ODER 'HOCHZEITEN' BITTE DIE ENTSPRECHENDEN BEGRIFFE VERWENDEN."@de,
    "MÅ IKKE FORVEKSLES MED EKTESKAPSRATER ELLER VIELSER."@no, "NE PAS UTILISER POUR MESURER LE TAUX DE NUPTIALITÉ OU LES CÉRÉMONIES DE MARIAGE"@fr,
    "NENAUDOKITE SANTUOKŲ RODIKLIAMS MATUOTI ARBA SANTUOKOS CEREMONIJAI APIBŪDINTI. "@lt,
    "NIET GEBRUIKEN VOOR HET METEN VAN DE HUWELIJKSCIJFERS OF VOOR DE HUWELIJKSCEREMONIE."@nl,
    "NO DEBE USARSE PARA MEDICIÓN DE TASAS DE MATRIMONIO O PARA LA CEREMONIA DEL MATRIMONIO"@es,
    "SKA INTE ANVÄNDAS FÖR MÅTT PÅ ÄKTENSKAPSFREKVENS ELLER FÖR BRÖLLOP/VIGSEL"@sv;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "ÄKTENSKAP"@sv, "AVIOLIITTO"@fi, "CĂSĂTORIE"@ro, "EHE"@de, "EKTESKAP"@no,
    "HÁZASSÁG"@hu, "HJÓNABAND"@is, "HUWELIJK"@nl, "MANŽELSTVÍ"@cs, "MARIAGE"@fr, "MARRIAGE"@en,
    "MATRIMONIO"@es, "SANTUOKA"@lt, "ZAKONSKA ZVEZA"@sl, "ΓΑΜΟΣ"@el;
  skos:altLabel "GLEICHGESCHLECHTLICHE EHE"@de, "HOMOSEKSUALIŲ ASMENŲ SANTUOKA"@lt,
    "LIKEKJØNNET EKTESKAP"@no, "MARIAGE ENTRE PERSONNES DE MÊME SEXE"@fr, "MARIAGE ENTRE PERSONNES HÉTÉROSEXUELLES"@fr,
    "MARIAGE HOMOSEXUEL"@fr, "MATRIMONIO DE PERSONAS DEL MISMO SEXO"@es, "SAME-SEX MARRIAGE"@en,
    "SAMKÖNADE ÄKTENSKAP"@sv, "TASA-ARVOINEN AVIOLIITTO"@fi, "TOS PAČIOS LYTIES ASMENŲ SANTUOKA"@lt,
    "TOS PAČIOS LYTIES SANTUOKA"@lt, "ΓΑΜΟΣ ΟΜΟΦΥΛΩΝ"@el;
  skos:historyNote "ANTES DE JULIO DE 2015, EL TÉRMINO \"MATRIMONIO DE PERSONAS DEL MISMO SEXO\" ERA UN TÉRMINO DE SUSTITUCIÓN DE \"UNIONES CIVILES\""@es,
    "FÖRE JULI 2015 VAR 'SAMKÖNAT ÄKTENSKAP' EN ENTRY TERM FÖR REGISTRERAT PARTNERSKAP"@sv,
    "LE TERME DE REMPLACEMENT 'MARIAGE HOMOSEXUEL' A ÉTÉ AJOUTÉ EN JUILLET 2015. AUPARAVANT 'MARIAGE HOMOSEXUEL' ÉTAIT UN TERME DE REMPLACEMENT DE 'PARTERNARIATS CIVILS'"@fr,
    "TERMINAS \"TOS PAČIOS LYTIES ASMENŲ SANTUOKA\" BUVO ĮTRAUKTAS 2015 M. LIEPOS MĖN. ANKSČIAU \"TOS PAČIOS LYTIES ASMENŲ SANTUOKA\" BUVO \"CIVILINĖS PARTNERYSTĖS\" TERMINU."@lt,
    "THE ENTRY TERM 'SAME-SEX MARRIAGE' WAS ADDED JULY 2015. PREVIOUSLY 'SAME-SEX MARRIAGE' WAS AN ENTRY TERM OF 'CIVIL PARTNERSHIPS'."@en;
