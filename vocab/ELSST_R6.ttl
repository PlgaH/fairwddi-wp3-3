<https://elsst.cessda.eu/id/6/050ea95f-f772-48c9-8cb9-96d5b5cfa3a4> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/050ea95f-f772-48c9-8cb9-96d5b5cfa3a4>;
  skos:definition "LIVSMEDEL SOM GES SOM BISTÅND TILL ETT LAND ELLER EN REGION SOM DRABBATS AV MATBRIST."@sv,
    "MATVÆLI SEM ERU VEITT LANDI EÐA SVÆÐI SEM LÍÐUR MATVÆLASKORT"@is, "POTRAVINY POSKYTOVANÉ JAKO POMOC ZEMI NEBO OBLASTI TRPÍCÍ NEDOSTATKEM POTRAVIN"@cs,
    """AID GIVEN TO AN EXTERNAL COUNTRY OR REGION SUFFERING FROM FOOD INSECURITY. MAY INCLUDE FOOD ITEMS OR MONEY GIVEN SPECIFICALLY TO PURCHASE FOOD.
"""@en,
    "HILFE FÜR EIN LAND ODER EINE REGION IM AUSLAND, DAS BZW. DIE UNTER ERNÄHRUNGSUNSICHERHEIT LEIDET. KANN NAHRUNGSMITTEL ODER GELD UMFASSEN, DAS SPEZIELL FÜR DEN KAUF VON NAHRUNGSMITTELN BEREITGESTELLT WIRD."@de,
    "PAGALBA, TEIKIAMA UŽSIENIO ŠALIAI AR REGIONUI, KENČIANČIAM NUO MAISTO TRŪKUMO. GALI APIMTI MAISTO PRODUKTUS ARBA PINIGUS, SKIRTUS SPECIALIAI MAISTUI ĮSIGYTI."@lt,
    "BISTAND GITT TIL ET EKSTERNT LAND ELLER EN REGION SOM LIDER AV MATUSIKKERHET. KAN INNEBÆRE MATVARER ELLER PENGER SPESIFIKT ØREMERKET TIL Å KJØPE MAT."@no,
    "AYUDA PRESTADA A UN PAÍS O REGIÓN EXTERNO QUE SUFRE INSEGURIDAD ALIMENTARIA. PUEDE INCLUIR ALIMENTOS O DINERO DESTINADO ESPECÍFICAMENTE A LA COMPRA DE ALIMENTOS."@es,
    """POMOČ V HRANI DRUGI DRŽAVI ALI REGIJI, KI TRPI ZARADI POMANJKANJA HRANE. LAHKO VKLJUČUJE HRANO ALI DENARNA SREDSTVA, NAMENJENA IZKLJUČNO ZA NAKUP HRANE.

"""@sl,
    """POMOČ V HRANI DRUGI DRŽAVI ALI REGIJI, KI TRPI ZARADI POMANJKANJA HRANE. LAHKO VKLJUČUJE HRANO ALI DENARNA SREDSTVA, NAMENJENA IZKLJUČNO ZA NAKUP HRANE.
"""@sl,
    "Η ΒΟΗΘΕΙΑ ΠΟΥ ΠΑΡΕΧΕΤΑΙ ΣΕ ΧΩΡΑ ΤΟΥ  ΕΞΩΤΕΡΙΚΟΥ  Ή ΣΕ ΠΕΡΙΟΧΗ ΠΟΥ ΑΝΤΙΜΕΤΩΠΙΖΕΙ ΕΠΙΣΙΤΙΣΤΙΚΗ ΑΝΑΣΦΑΛΕΙΑ. Η ΒΟΗΘΕΙΑ ΜΠΟΡΕΙ ΝΑ ΠΕΡΙΛΑΜΒΑΝΕΙ ΤΡΟΦΙΜΑ Ή ΧΡΗΜΑΤΑ ΠΟΥ ΔΙΝΟΝΤΑΙ ΕΙΔΙΚΑ ΓΙΑ ΤΗΝ ΑΓΟΡΑ ΤΡΟΦΙΜΩΝ"@el,
    "AIDE APPORTÉE À UN PAYS OU À UNE RÉGION EXTÉRIEURE SOUFFRANT D'INSÉCURITÉ ALIMENTAIRE. ELLE PEUT COMPRENDRE DES DENRÉES ALIMENTAIRES OU DE L'ARGENT DONNÉ SPÉCIFIQUEMENT POUR ACHETER DE LA NOURRITURE."@fr,
    "HULP AAN EEN BUITENLANDS LAND OF REGIO DAT TE KAMPEN HEEFT MET VOEDSELONZEKERHEID. KAN VOEDSELPRODUCTEN OF GELD OMVATTEN DAT SPECIFIEK IS BESTEMD VOOR DE AANKOOP VAN VOEDSEL."@nl;
  skos:scopeNote "SKA INTE BLANDAS IHOP MED \"MATBANKER\"."@sv, "EKKI RUGLA SAMAN VIÐ 'MATARAÐSTOÐ'"@is,
    "NEZAMĚŇUJTE S \"POTRAVINOVÉ BANKY\""@cs, "FOR DOMESTIC FOOD AID USE THE TERM 'FOOD AID (DOMESTIC)'."@en,
    "FÜR INLÄNDISCHE NAHRUNGSMITTELHILFE BENUTZEN SIE BITTE DEN BEGRIFF 'NAHRUNGSMITTELHILFE (INLAND)'"@de,
    "KALBANT APIE PAGALBĄ MAISTU ŠALIES VIDUJE, NAUDOKITE TERMINĄ \"PAGALBA MAISTU (VIDAUS)\"."@lt,
    "FOR NASJONAL MATBISTAND BRUK BEGREPET 'MATBISTAND (NASJONAL)'."@no, "PARA LA AYUDA ALIMENTARIA NACIONAL, UTILIZAR EL TÉRMINO \"AYUDA ALIMENTARIA (INTERNA)\"."@es,
    "ΓΙΑ ΕΓΧΩΡΙΑ ΕΠΙΣΙΤΙΣΤΙΚΗ ΒΟΗΘΕΙΑ ΧΡΗΣΙΜΟΠΟΙΗΣΤΕ ΤΟΝ ΟΡΟ \"ΕΠΙΣΙΤΙΣΤΙΚΗ ΒΟΗΘΕΙΑ (ΕΓΧΩΡΙΑ)\""@el,
    "POUR L'AIDE ALIMENTAIRE NATIONALE, UTILISER LE TERME \"AIDE ALIMENTAIRE (NATIONALE)\"."@fr,
    "GEBRUIK VOOR BINNENLANDSE VOEDSELHULP DE TERM ‘VOEDSELHULP (BINNENLANDS)’."@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "AJUTOR ALIMENTAR"@ro, "ELINTARVIKEAPU (KANSAINVÄLINEN APU)"@fi, "LIVSMEDELSBISTÅND"@sv,
    "FOOD AID (INTERNATIONAL)"@en, "NAHRUNGSMITTELHILFE (INTERNATIONAL)"@de, "PAGALBA MAISTU (TARPTAUTINĖ)"@lt,
    "AIDE ALIMENTAIRE (INTERNATIONALE)"@fr, "MATVÆLAAÐSTOÐ (ALÞJÓÐLEG)"@is, "POTRAVINOVÁ POMOC (MEZINÁRODNÍ)"@cs,
    "VOEDSELHULP (INTERNATIONAAL)"@nl, "MATBISTAND (INTERNASJONAL)"@no, "AYUDA ALIMENTARIA (INTERNACIONAL)"@es,
    "ÉLELMISZERSEGÉLY (NEMZETKÖZI)"@hu, "POMOČ V HRANI (MEDNARODNA)"@sl, "ΕΠΙΣΙΤΙΣΤΙΚΗ ΒΟΗΘΕΙΑ/ΕΝΙΣΧΥΣΗ (ΔΙΕΘΝΗΣ)"@el;
  skos:altLabel "MATBISTAND"@no, "ΒΟΗΘΕΙΑ ΣΕ ΤΡΟΦΙΜΑ"@el, "LEBENSMITTELHILFE (INTERNATIONAL)"@de,
    "LEBENSMITTELHILFEN (INTERNATIONAL)"@de, "NAHRUNGSMITTELHILFEN (INTERNATIONAL)"@de,
    "MATVÆLAAÐSTOÐ"@is, "FOOD ASSISTANCE (INTERNATIONAL)"@en, "ERNÄHRUNGSHILFE (INTERNATIONAL)"@de,
    "ERNAEHRUNGSHILFE (INTERNATIONAL)"@de, "PAGALBA MAISTO PRODUKTAIS (TARPTAUTINĖ)"@lt,
    "PAGALBA MAISTO SRITYJE (TARPTAUTINĖ)"@lt, "ASSISTANCE ALIMENTAIRE (INTERNATIONALE)"@fr,
    "ASISTENCIA ALIMENTARIA (INTERNACIONAL)"@es, "MATHJELP (INTERNASJONAL)"@no, "VOEDSELBIJSTAND (INTERNATIONAAL)"@nl;
  skos:historyNote "TERM RELABELLED 2024. PREVIOUSLY THE TERM 'FOOD AID' WOULD HAVE BEEN USED."@en,
    "BEGRIFF UMBENANNT 2024. VORHER WURDE DER BEGRIFF 'NAHRUNGSMITTELHILFE' BENUTZT."@de,
    "Ο ΟΡΟΣ ΜΕΤΟΝΟΜΑΣΤΗΚΕ ΤΟ 2024. Ο ΠΡΟΗΓΟΥΜΕΝΟΣ ΟΡΟΣ ΠΟΥ ΧΡΗΣΙΜΟΠΟΙΟΥΝΤΑΝ  \"ΕΠΙΣΙΤΙΣΤΙΚΗ ΒΟΗΘΕΙΑ\""@el,
    "TERMINAS PERVADINTAS 2024 M. ANKSČIAU BUVO NAUDOJAMAS TERMINAS \"PAGALBA MAISTU\"."@lt,
    "TERMÍN PŘEJMENOVÁN V ROCE 2024. PŘED TÍM BYL POUŽÍVÁN TERMÍN \"POTRAVINOVÁ POMOC\""@cs,
    "TERM OPNIEUW GELABELD 2024. VOORHEEN ZOU DE TERM 'VOEDSELHULP' ZIJN GEBRUIKT."@nl,
    "TERM ENDRET I 2024. TIDLIGERE VILLE TERMEN \"MATBISTAND\" HA VÆRT BRUKT. "@no, "TÉRMINO RECATALOGADO EN 2024. ANTERIORMENTE SE UTILIZABA EL TÉRMINO \"ASISTENCIA ALIMENTARIA\"."@es,
    "TERME RELABELLISÉ EN 2024. AUPARAVANT, LE TERME \"ASSISTANCE ALIMENTAIRE\" ÉTAIT UTILISÉ"@fr;
