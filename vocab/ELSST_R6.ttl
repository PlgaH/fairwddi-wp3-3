<https://elsst.cessda.eu/id/6/4584ac44-0377-4791-a6f9-80e6c461c513> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/4584ac44-0377-4791-a6f9-80e6c461c513>;
  skos:definition "ENERGIAN TUOTANTOON, SIIRTOON, JAKELUUN JA VARASTOINTIIN KÄYTETTÄVÄT JÄRJESTELMÄT JA VÄLINEET"@fi,
    "ENERGIJOS GENERAVIMO, PERDAVIMO, PASKIRSTYMO IR KAUPIMO SISTEMOS IR ĮRENGINIAI."@lt,
    "SERVICII ȘI UTILITĂȚI NECESARE DISTRIBUȚIEI ENERGIEI ELECTRICE LA NIVEL NAȚIONAL"@ro,
    "SISTEMAS E INSTALACIONES DE GENERACIÓN, TRANSMISIÓN, DISTRIBUCIÓN Y ALMACENAMIENTO DE ENERGÍA"@es,
    "SISTEMI IN OBJEKTI ZA PROIZVODNJO, PRENOS, DISTRIBUCIJO IN HRANJENJE ENERGIJE"@sl,
    "SYSTEM OCH ANLÄGGNINGAR FÖR PRODUKTION, ÖVERFÖRING, DISTRIBUTION OCH LAGRING AV ENERGI."@sv,
    "SYSTEME UND EINRICHTUNGEN ZUR ERZEUGUNG, ÜBERTRAGUNG, VERTEILUNG UND SPEICHERUNG VON ENERGIE."@de,
    "SYSTEMEN EN FACILITEITEN VOOR ENERGIEOPWEKKING, -TRANSMISSIE, -DISTRIBUTIE EN -OPSLAG"@nl,
    "SYSTÈMES ET INSTALLATIONS DE PRODUCTION, TRANSMISSION, DISTRIBUTION ET STOCKAGE DE L'ÉNERGIE"@fr,
    "SYSTEMS AND FACILITIES FOR ENERGY GENERATION, TRANSMISSION, DISTRIBUTION AND STORAGE"@en,
    "TJENESTER OG ANLEGG SOM ER NØDVENDIGE FOR ENERGIFORSYNING TIL ET NASJONALT NETT."@no,
    "ΣΥΣΤΗΜΑΤΑ ΚΑΙ ΕΓΚΑΤΑΣΤΑΣΕΙΣ ΠΑΡΑΓΩΓΗΣ , ΜΕΤΑΦΟΡΑΣ, ΔΙΑΝΟΜΗΣ ΚΑΙ ΑΠΟΘΗΚΕΥΣΗΣ ΕΝΕΡΓΕΙΑΣ"@el;
  skos:scopeNote "A NU SE CONFUNDA CU TERMENUL „ALIMENTARE CU ENERGIE” CARE SE REFERĂ LA ALIMENTAREA CU ENERGIE A UNEI CLĂDIRI"@ro,
    "BITTE NICHT MIT DEM BEGRIFF 'ENERGIEVERSORGUNG' VERWECHSELN, DER SICH AUF DIE ENERGIEVERSORGUNG EINES GEBÄUDES BEZIEHT."@de,
    "DO NOT CONFUSE WITH THE TERM 'ENERGY SUPPLY' WHICH REFERS TO THE ENERGY SUPPLY TO A BUILDING"@en,
    "EI TULE SEKOITTAA TERMIIN 'ENERGIAHUOLTO', JOLLA VIITATAAN YKSITTÄISTEN RAKENNUSTEN ENERGIANSAANTIIN."@fi,
    "MÅ IKKE FORVEKSLES MED TERMEN 'ENERGIFORSYNING' SOM VISER TIL FORSYNING MED ENERGI TIL EN BYGNING"@no,
    "NE PAS CONFONDRE AVEC LE TERME 'APPROVISIONNEMENT ÉNERGÉTIQUE' QUI DÉSIGNE L'APPROVISIONNEMENT EN ÉNERGIE D'UN BÂTIMENT."@fr,
    "NEPAINIOTI SU TERMINU „ENERGIJOS TIEKIMAS“, KURIS SUSIJĘS SU ENERGIJOS TIEKIMU PASTATO VIDUJE."@lt,
    "NIET TE VERWARREN MET DE TERM 'ENERGIEVOORZIENING', DIE BETREKKING HEEFT OP DE ENERGIEVOORZIENING VAN EEN GEBOUW"@nl,
    "NO CONFUNDIR CON EL TÉRMINO \"SUMINISTRO ENERGÉTICO\" QUE SE REFIERE A LA ENERGÍA QUE SE SUMINISTRA A UNA EDIFICACIÓN."@es,
    "SKA INTE BLANDAS IHOP MED TERMEN 'ENERGIFÖRSÖRJNING' SOM SYFTAR PÅ ENERGITILLFÖRSELN TILL T.EX. FASTIGHETER."@sv;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
