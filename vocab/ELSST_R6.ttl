<https://elsst.cessda.eu/id/6/8072c68b-b158-4735-b046-dd3412988da8> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/8072c68b-b158-4735-b046-dd3412988da8>;
  skos:definition "DEZE TERM SLUIT FYSISCHE EN CULTURELE GEOGRAFIE UIT"@nl, "EI SISÄLLÄ FYYSISTÄ MAANTIEDETTÄ EIKÄ KULTTUURIMAANTIEDETTÄ."@fi,
    "ESTE TÉRMINO EXCLUYE LA GEOGRAFÍA FÍSICA Y LA GEOGRAFÍA CULTURAL."@es, "IKKE FYSISK GEOGRAFI OG KULTURELL GEOGRAFI."@no,
    "NE COMPREND PAS LA GÉOGRAPHIE PHYSIQUE NI LA GÉOGRAPHIE CULTURELLE."@fr, "NU INCLUDE GEOGRAFIA FIZICĂ ȘI GEOGRAFIA CULTURALĂ. PENTRU GEOGRAFIA FIZICĂ FOLOSIȚI 'EDUCAȚIE ÎN ȘTIINȚELE FIZICII'. PENTRU GEOGRAFIA CULTURALĂ FOLOSIȚI 'STUDII CULTURALE'. "@ro,
    "OHNE DIE AUSBILDUNGSFÄCHER PHYSISCHE GEOGRAPHIE UND KULTURGEOGRAPHIE. FÜR PHYSISCHE GEOGRAPHIE ALS AUSBILDUNGSFACH VERWENDEN SIE BITTE 'PHYSIK, CHEMIE UND GEOWISSENSCHAFTEN (AUSBILDUNG)'. FÜR KULTURGEOGRAPHIE ALS AUSBILDUNGSFACH VERWENDEN SIE BITTE DEN BEGRIFF 'KULTURWISSENSCHAFT (AUSBILDUNG)'."@de,
    "OMFATTAR INTE FYSISK GEOGRAFI OCH KUTORGEOGRAFI. "@sv, "THIS TERM EXCLUDES PHYSICAL GEOGRAPHY AND CULTURAL GEOGRAPHY."@en,
    "Ο ΟΡΟΣ ΑΥΤΟΣ ΑΠΟΚΛΕΙΕΙ ΤΗΝ ΦΥΣΙΚΗ ΓΕΩΓΡΑΦΙΑ ΚΑΙ ΤΗΝ ΠΟΛΙΤΙΣΤΙΚΗ ΓΕΩΓΡΑΦΙΑ"@el, "ŠIS TERMINAS NEAPIMA FIZINĖS IR KULTŪRINĖS GEOGRAFIJOS."@lt;
  skos:scopeNote "FIZINĖS GEOGRAFIJOS UGDYMUI NAUDOKITE TERMINĄ „FIZINIŲ MOKSLŲ MOKYMAS“. KULTŪRINĖS GEOGRAFIJOS UGDYMUI NAUDOKITE TERMINĄ „KULTŪROS STUDIJOS“."@lt,
    "FOR FYSISK GEOGRAFI BRUK TERMEN 'UTDANNING I FYSISK VITENSKAP'. FOR UTDANNING I KULTURELL GEOGRAFI, BRUK BEGREPET 'KULTURELLE STUDIER'"@no,
    "FOR PHYSICAL GEOGRAPHY EDUCATION USE THE TERM 'PHYSICAL SCIENCES EDUCATION'. FOR CULTURAL GEOGRAPHY EDUCATION USE THE TERM 'CULTURAL STUDIES'."@en,
    "FÖR UTBILDNING I FYSISK GEOGRAFI, ANVÄND TERMEN 'UTBILDNING I FYSISKA VETENSKAPER'. FÖR KULTURGEOGRAFI, ANVÄND TERMEN 'UTBILDNING I KULTURVETENSKAP'."@sv,
    "FYYSISESTÄ MAANTIETEESTÄ KÄYTÄ TERMIÄ 'ELOTTOMAN LUONNON TIETEET (KOULUTUSALA)' JA KULTTUURIMAANTIETEESTÄ 'KULTTUURINTUTKIMUS (KOULUTUSALA)."@fi,
    "PARA LA ENSEÑANZA DE LA GEOGRAFÍA FÍSICA, UTILIZAR EL TÉRMINO \"FORMACIÓN EN CIENCIAS FÍSICAS\". PARA LA ENSEÑANZA DE LA GEOGRAFÍA CULTURAL, UTILIZAR EL TÉRMINO \"ESTUDIOS CULTURALES\"."@es,
    "POUR L'ENSEIGNEMENT DE LA GÉOGRAPHIE PHYSIQUE, UTILISER LE TERME 'ENSEIGNEMENT DES SCIENCES PHYSIQUES'. POUR L'ENSEIGNEMENT DE LA GÉOGRAPHIE CULTURELLE, UTILISER LE TERME 'ÉTUDES CULTURELLES'."@fr;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "AARDRIJKSKUNDE"@nl, "EDUCAȚIE ÎN GEOGRAFIE"@ro, "FÖLDRAJZOKTATÁS"@hu,
    "FORMACIÓN EN GEOGRAFÍA"@es, "FORMATION EN GÉOGRAPHIE"@fr, "GEOGRAFIJOS MOKYMAS"@lt,
