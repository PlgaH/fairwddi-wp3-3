  skos:definition "AUSGENOMMEN KRANKENHAUSPFLEGE."@de, "CE TERME EXCLUT LES SOINS HOSPITALIERS. POUR DÉSIGNER LES SOINS HOSPITALIERS, UTILISER LE TERME 'SERVICES HOSPITALIERS'."@fr,
    "DEN HÄR TERMEN OMFATTAR INTE SJUKHUSVÅRD."@sv, "DEZE TERM IS EXCLUSIEF ZIEKENHUISZORG"@nl,
    "EI SISÄLLÄ SAIRAALAHOITOA."@fi, "ESTE TÉRMINO EXCLUYE LA ATENCIÓN HOSPITALARIA."@es,
    "FĂRĂ ÎNGRIJIREA SPITALICEASCĂ. PENTRU ÎNGRIJIREA ÎN SPITALE FOLOSIȚI 'SERVICII SPITALICEȘTI'."@ro,
    "INKLUDERER IKKE PLEIE PÅ SYKEHUS."@no, "IŠSKYRUS GYDYMĄ LIGONINĖSE."@lt, "THIS TERM EXCLUDES HOSPITAL CARE."@en,
    "ΕΞΑΙΡΕΙΤΑΙ Η ΝΟΣΟΚΟΜΕΙΑΚΗ ΦΡΟΝΤΙΔΑ. ΓΙΑ ΤΗ ΝΟΣΟΚΟΜΕΙΑΚΗ ΦΡΟΝΤΙΔΑ ΧΡΗΣΙΜΟΠΟΙΗΣΤΕ ΤΟΝ ΟΡΟ 'ΝΟΣΟΚΟΜΕΙΑΚΕΣ ΥΠΗΡΕΣΙΕΣ'"@el;
  skos:scopeNote "ANVÄND TERMEN 'SJUKHUSSERVICE' FÖR SJUKHUSVÅRD."@sv, "FOR HOSPITAL CARE USE THE TERM 'HOSPITAL SERVICES'."@en,
    "FOR PLEIE PÅ SYKEHUS BENYTTES TERMEN 'SYKEHUSTJENESTER'."@no, "FÜR PFLEGE IM KRANKENHAUS BITTE DEN BEGRIFF 'KRANKENHAUSWESEN' VERWENDEN."@de,
    "LIGONINĖJE TEIKIAMOMS PASLAUGOMS APIBŪDINTI NAUDOKITE TERMINĄ „LIGONINĖS PASLAUGOS“."@lt,
    "PARA LA ATENCIÓN HOSPITALARIA UTILIZAR EL TÉRMINO \"SERVICIOS HOSPITALARIOS\"."@es,
    "POUR LES SOINS HOSPITALIERS, UTILISER LE TERME 'SERVICES HOSPITALIERS'"@fr, "SAIRAALASSA ANNETTAVASTA HOIDOSTA KÄYTÄ TERMIÄ 'SAIRAALAHOITO'."@fi,
    "VOOR ZIEKENHUISVERPLEGING WORDT DE TERM 'ZIEKENHUISVERPLEGING' GEBRUIKT"@nl;
