<https://elsst.cessda.eu/id/6/7ab9034d-8a1d-49aa-a8af-798317fccd31> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/7ab9034d-8a1d-49aa-a8af-798317fccd31>;
  skos:definition "Ο ΟΡΟΣ ΧΡΗΣΙΜΟΠΟΙΕΙΤΑΙ ΓΙΑ ΟΙΚΟΝΟΜΙΚΗ ΒΟΗΘΕΙΑ ΣΕ ΔΙΕΘΝΕΣ, ΕΘΝΙΚΟ Ή ΤΟΠΙΚΟ ΕΠΙΠΕΔΟ. ΓΙΑ ΟΙΚΟΝΟΜΙΚΗ ΒΟΗΘΕΙΑ ΣΕ ΠΡΟΣΩΠΙΚΟ ΕΠΙΠΕΔΟ ΧΡΗΣΙΜΟΠΟΙΗΣΕ ΤΟΝ ΟΡΟ 'ΟΙΚΟΝΟΜΙΚΗ ΕΝΙΣΧΥΣΗ'"@el,
    "ACEST TERMEN SE FOLOSEȘTE PENTRU AJUTORUL FINANCIAR LA NIVEL PERSONAL. PENTRU AJUTORUL FINANCIAR LA NIVEL NAȚIONAL, INTERNAȚIONAL SAU REGIONAL, FOLOSIȚI 'AJUTOR ECONOMIC'"@ro,
    "AYUDA FINANCIERA A NIVEL PERSONAL"@es, "DENNA TERM ANVÄNDS FÖR EKONOMISK HJÄLP PÅ INDIVIDNIVÅ."@sv,
    "DENNE TERMEN ER BRUKT FOR ALL FINANSIELL HJELP TIL PERSONER."@no, "DIESER BEGRIFF BESCHREIBT FINANZIELLE HILFE AUF PERSÖNLICHER EBENE."@de,
    "KALBAMA APIE FINANSINĘ PAGALBĄ ASMENINIU LYGMENIU."@lt, "REFERS TO FINANCIAL AID AT A PERSONAL LEVEL"@en,
    "UTILISER POUR L'AIDE FINANCIÈRE AU NIVEAU PERSONNEL. UTILISER LE TERME 'AIDE ÉCONOMIQUE' POUR L'AIDE INTERNATIONALE, NATIONALE, OU RÉGIONALE."@fr,
    "VERWIJST NAAR FINANCIËLE STEUN OP PERSOONLIJK NIVEAU"@nl, "VIITTAA YKSITYISEN HENKILÖN TALOUDELLISEEN TUKEEN."@fi;
  skos:scopeNote "ANVÄND TERMEN ”EKONOMISKT BISTÅND” FÖR INTERNATIONELL, NATIONELL ELLER REGIONAL HJÄLP."@sv,
    "FOR HJELP PÅ INTERNASJONALT, NASJONALT OG REGIONALT NIVÅ BRUK TERMEN ”ØKONOMISK HJELP”."@no,
    "FOR INTERNATIONAL, NATIONAL OR REGIONAL FINANCIAL AID USE THE TERM 'ECONOMIC AID'."@en,
    "FÜR FINANZIELLE HILFE AUF INTERNATIONALER, NATIONALER ODER REGIONALER EBENE VERWENDEN SIE BITTE DEN BEGRIFF 'WIRTSCHAFTSHILFE'."@de,
    "KANSAINVÄLISESTÄ, KANSALLISESTA TAI ALUEELLISESTA TUESTÄ KÄYTETÄÄN TERMIÄ 'TALOUDELLINEN APU'."@fi,
    "PARA LA AYUDA FINANCIERA INTERNACIONAL, NACIONAL O REGIONAL, UTILIZAR EL TÉRMINO \"AYUDA ECONÓMICA\"."@es,
    "TARPTAUTINEI, NACIONALINEI AR REGIONINEI FINANSINEI PAGALBAI, NAUDOKITE TERMINĄ „EKONOMINĖ PAGALBA“."@lt,
    "VOOR INTERNATIONALE, NATIONALE OF REGIONALE FINANCIËLE STEUN WORDT DE TERM 'ECONOMISCHE STEUN' GEBRUIKT"@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
