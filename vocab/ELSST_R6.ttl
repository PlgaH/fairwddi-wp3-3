<https://elsst.cessda.eu/id/6/1b13b297-5866-46a6-9221-4a488c90b713> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/1b13b297-5866-46a6-9221-4a488c90b713>;
  skos:definition "A SE FOLOSI ÎN CAZUL VACANȚELOR SAU CONCEDIILOR PENTRU PUBLICUL GENERAL. PENTRU VACANȚELE EDUCAȚIONALE ORGANIZATE DE ȘCOLI A SE FOLOSI TERMENUL 'VIZITE EDUCAȚIONALE'. "@ro,
    "BRUKES OM FERIER/REISER FOR FOLK FLEST"@no, "DIESER BEGRIFF BEZIEHT SICH AUF URLAUBSREISEN FÜR DIE ALLGEMEINE ÖFFENTLICHKEIT."@de,
    "GÄLLER SEMESTER FÖR ALLMÄNHETEN."@sv, "REFERS TO HOLIDAYS FOR THE GENERAL PUBLIC"@en,
    "SE REFIERE A LAS VACACIONES PARA EL PÚBLICO EN GENERAL"@es, "VACANCES ÉDUCATIVES DESTINÉES AU GRAND PUBLIC. POUR LES VACANCES ÉDUCATIVES ORGANISÉES PAR LES ÉTABLISSEMENTS SCOLAIRES, UTILISER LE TERME 'SORTIES SCOLAIRES'."@fr,
    "VERWIJST NAAR VAKANTIES VOOR DE ALGEMENE PUBLIEK"@nl, "VIITTAA SUURELLE YLEISÖLLE SUUNNATTUIHIN LOMAMATKOIHIN, JOISSA ON OPETUKSELLISTA SISÄLTÖÄ."@fi,
    "ΧΡΗΣΙΜΟΠΟΙΕΙΤΑΙ ΓΙΑ ΤΙΣ ΔΙΑΚΟΠΕΣ ΕΚΤΟΣ ΣΧΟΛΙΚΟΥ ΠΛΑΙΣΙΟΥ. ΓΙΑ ΤΙΣ ΔΙΑΚΟΠΕΣ ΠΟΥ ΔΙΟΡΓΑΝΩΝΟΝΤΑΙ ΑΠΟ ΚΑΠΟΙΟ ΕΚΠΑΙΔΕΥΤΙΚΟ ΙΔΡΥΜΑ, ΧΡΗΣΙΜΟΠΟΙΗΣΤΕ ΤΟΝ ΟΡΟ: «ΕΚΠΑΙΔΕΥΤΙΚΕΣ ΕΠΙΣΚΕΨΕΙΣ»."@el,
    "APIBŪDINA ATOSTOGAS, SKIRTAS PLAČIAJAI VISUOMENEI."@lt;
  skos:scopeNote "ANVÄND 'STUDIEBESÖK' FÖR BILDNINGSSEMESTER SOM ANORDNAS AV SKOLOR."@sv,
    "FOR EDUCATIONAL HOLIDAYS ORGANIZED BY SCHOOLS, USE THE TERM 'EDUCATIONAL VISITS'."@en,
    "FOR UTDANNIGNSRELATERTE FERIER ORGANISERT AV SKOLER BRUK TERMEN ”EKSKURSJONER”"@no,
    "FÜR BILDUNGSREISEN, DIE VON SCHULEN ORGANISIERT WERDEN, VERWENDEN SIE BITTE DEN BEGRIFF 'STUDIENFAHRTEN'. BITTE NICHT MIT DEM BEGRIFF 'BILDUNGSURLAUB' VERWECHSELN, DER FÜR VOM ARBEITGEBER BEZAHLTEN ODER UNBEZAHLTEN URLAUB FÜR ARBEITNEHMER ZU BILDUNGSZWECKEN VERWENDET WIRD."@de,
    "KOULUJEN JÄRJESTÄMISTÄ MATKOISTA KÄYTÄ TERMIÄ 'OPINTOVIERAILUT'."@fi, "ORGANIZUOJAMOMS EDUKACINĖMS ATOSTOGOMS NAUDOKITE TERMINĄ „UGDOMOSIOS IŠVYKOS“."@lt,
    "PARA VACACIONES EDUCATIVAS ORGANIZADAS POR LAS ESCUELAS, UTILIZAR EL TÉRMINO \"VISITAS EDUCATIVAS\"."@es,
    "VOOR EDUCATIEVE VAKANTIES GEORGANISEERD DOOR SCHOLEN, GEBRUIK DE TERM 'EDUCATIEVE BEZOEKEN'"@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "BILDNINGSSEMESTRAR"@sv, "BILDUNGSREISEN"@de, "EDUCATIEVE VAKANTIES"@nl,
