    "GESCHLECHTSIDENTITAET"@de, "LYTIES TAPATYBĖ"@lt, "MASCULINITATE"@ro, "POHLAVNÍ IDENTITA"@cs,
    "SEKSUALINĖ TAPATYBĖ"@lt, "SEXUELLE IDENTITAET"@de, "SEXUELLE IDENTITÄT"@de, "ΤΑΥΤΟΤΗΤΑ ΤΟΥ ΦΥΛΟΥ"@el;
  skos:historyNote "2021 M. BALANDŽIO MĖN. TERMINAS PERVADINTAS. ANKSČIAU BUVO NAUDOJAMAS TERMINAS \"SEKSUALINĖ TAPATYBĖ\". TERMINAS 'SEKSUALINĖ TAPATYBĖ' IKI 2018-08-31 BUVO VERČIAMAS 'SEKSUALINIS TAPATUMAS'. "@lt,
    "TERM OPNIEUW GELABELD APRIL 2021. VOORHEEN ZOU DE TERM \"SEKSUELE IDENTITEIT\" ZIJN GEBRUIKT"@nl,
    "TERM RELABELLED APRIL 2021. PREVIOUSLY THE TERM 'SEXUAL IDENTITY' WOULD HAVE BEEN USED."@en,
    "TERM UMBENANNT IM APRIL 2021. VORHERIGE VORZUGSBENENNUNG 'SEXUELLE IDENTITÄT'."@de,
    "TERME RELABELLISÉ EN AVRIL 2021. AUPARAVANT LE TERME 'IDENTITÉ SEXUELLE' ÉTAIT UTILISÉ."@fr,
    "TERMEN ÄNDRADES I APRIL 2021. INNAN DESS ANVÄNDES \"SEXUELL IDENTITET\"."@sv, "TÉRMINO RECATALOGADO EN ABRIL DE 2021. ANTERIORMENTE SE UTILIZABA EL TÉRMINO \"IDENTIDAD SEXUAL\"."@es;
