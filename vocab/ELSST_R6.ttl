<https://elsst.cessda.eu/id/6/0e775bb3-2932-403d-8290-789d30847829> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/0e775bb3-2932-403d-8290-789d30847829>;
  skos:definition "Å UTSETTE EN PERSON FOR SEKSUELL AKTIVITET SOM KAN FORÅRSAKE FYSISK ELLER PSYKISK SKADE. "@no,
    "ALISTAMINEN TAI PAINOSTAMINEN SEKSUAALISEEN TEKOON, JOKA AIHEUTTAA HENKILÖLLE FYYSISTÄ TAI PSYYKKISTÄ VAHINKOA"@fi,
    "ATT UTSÄTTA EN PERSON FÖR SEXUELLA AKTIVITETER SOM KAN ORSAKA FYSISK ELLER PSYKISK SKADA."@sv,
    "EINE PERSON SEXUELLEN HANDLUNGEN AUSLIEFERN, WODURCH KÖRPERLICHER ODER SEELISCHER SCHADEN VERURSACHT WERDEN KANN."@de,
