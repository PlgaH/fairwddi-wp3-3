<https://elsst.cessda.eu/id/6/6b026c0d-5dc0-422e-a425-67ee35f431fb> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/6b026c0d-5dc0-422e-a425-67ee35f431fb>;
  skos:definition "DE BEOOGDE FYSIOLOGISCHE OF PSYCHOLOGISCHE EFFECTEN VAN GENEESMIDDELEN"@nl,
    "DE INTENDERTE PSYKOSOSIALE OG PSYKISKE VIRKNINGENE AV MEDIKAMENTER."@no, "DEN AVSEDDA FYSIOLOGISKA ELLER PSYKOLOGISKA EFFEKTEN AV MEDICINER."@sv,
    "EFECTELE FIZIOLOGICE SAU PSIHOLOGICE CERCETATE (INTENȚIONATE) ALE MEDICAMENTELOR. A NU SE CONFUNDA CU EFECTELE SECUNDARE ALE ACESTORA."@ro,
    "EFFETS PHYSIOLOGIQUES OU PSYCHOLOGIQUES RECHERCHÉS DES MÉDICAMENTS. À NE PAS CONFONDRE AVEC LES EFFETS SECONDAIRES DES MÉDICAMENTS."@fr,
    "GEWÜNSCHTE WIRKUNGEN VON ARZNEIMITTELN AUF DEN KÖRPER ODER DIE PSYCHE."@de, "LOS EFECTOS FISIOLÓGICOS O PSICOLÓGICOS PREVISTOS DE LAS DROGAS"@es,
    "THE INTENDED PHYSIOLOGICAL OR PSYCHOLOGICAL EFFECTS OF DRUGS"@en, "VIITTAA LÄÄKKEIDEN TAVOITELTUIHIN FYSIOLOGISIIN TAI PSYKOLOGISIIN VAIKUTUKSIIN."@fi,
    "ΟΙ ΕΚ ΠΡΟΘΕΣΕΩΣ ΦΥΣΙΟΛΟΓΙΚΕΣ ΚΑΙ ΨΥΧΟΛΟΓΙΚΕΣ ΕΠΙΔΡΑΣΕΙΣ ΤΩΝ ΦΑΡΜΑΚΩΝ. ΝΑ ΜΗΝ ΣΥΓΧΕΕΤΑΙ ΜΕ ΤΙΣ ΠΑΡΕΝΕΡΓΕΙΕΣ ΤΩΝ ΦΑΡΜΑΚΩΝ "@el,
    "NUMATYTAS FIZIOLOGINIS AR PSICHOLOGINIS VAISTŲ POVEIKIS."@lt;
  skos:scopeNote "BITTE NICHT MIT DEM BEGRIFF 'ARZNEIMITTELNEBENWIRKUNGEN' VERWECHSELN."@de,
    "DO NOT CONFUSE WITH 'DRUG SIDE-EFFECTS'."@en, "LÄÄKKEIDEN ODOTTAMATTOMISTA TAI EI-TAVOITELLUISTA VAIKUTUKSISTA KÄYTÄ TERMIÄ 'LÄÄKKEIDEN SIVUVAIKUTUKSET'."@fi,
    "MÅ IKKE FORVEKSLES MED 'BIVIRKNINGER AV MEDISINER'"@no, "NE PAS CONFONDRE AVEC 'EFFETS SECONDAIRES DES MÉDICAMENTS'"@fr,
    "NEPAINIOTI SU „VAISTŲ ŠALUTINIS POVEIKIS“."@lt, "NIET VERWARREN MET 'BIJWERKINGEN VAN DRUGS'"@nl,
    "NO CONFUNDIR CON EL TÉRMINO \"EFECTOS SECUNDARIOS DE MEDICAMENTOS\""@es, "SKA INTE BLANDAS IHOP MED 'LÄKEMEDELSBIVERKNINGAR'."@sv;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
