<https://elsst.cessda.eu/id/6/7bb5a8be-a591-466b-858b-dec717199781> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/7bb5a8be-a591-466b-858b-dec717199781>;
  skos:definition "BEGREPET FØDSEL"@no, "CONCEPT DE NAISSANCE"@fr, "CONCEPTUL DE NAȘTERE SAU INFORMAȚII DESPRE NAȘTERILE INDIVIDUALE. A NU SE CONFUNDA CU  'NATALITATEA' SAU 'RATA NATALITĂȚII'."@ro,
    "EL CONCEPTO DE NACIMIENTO"@es, "GÄLLER FÖDELSE SOM FÖRETEELSE."@sv, "GIMIMO SĄVOKA."@lt,
    "HET BEGRIP GEBOORTE"@nl, "SYNTYMÄ KÄSITTEENÄ TAI YKSITTÄISIÄ SYNTYMIÄ KOSKEVA INFORMAATIO."@fi,
    "THE CONCEPT OF BIRTH"@en, "Η ΕΝΝΟΙΑ ΤΗΣ ΓΕΝΝΗΣΗΣ Ή ΠΛΗΡΟΦΟΡΙΕΣ ΣΧΕΤΙΚΑ ΜΕ ΤΙΣ ΑΤΟΜΙΚΕΣ ΓΕΝΝΗΣΕΙΣ. ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΕ ΜΕ ΤΗ 'ΓΕΝΝΗΤΙΚΟΤΗΤΑ' Ή ΜΕ ΤΟ 'ΔΕΙΚΤΗ ΓΕΝΝΗΣΕΩΝ'"@el,
    "BEZIEHT SICH ALLGEMEIN AUF DAS KONZEPT DER GEBURT ODER AUF INFORMATIONEN ZU EINZELNEN GEBURTEN. BITTE NICHT MIT DEN BEGRIFFEN 'GEBURTENZAHL ODER 'GEBURTENRATE' VERWECHSELN."@de;
  skos:scopeNote "ANVÄNDS FÖR INFORMATION OM INDIVIDUELLA FÖDSLAR. SKALL INTE SAMMANBLANDAS MED 'NATIVITET' ELLER 'FÖDELSETAL'."@sv,
    "EI TULE SEKOITTAA TERMEIHIN 'SYNTYMIEN MÄÄRÄ' TAI 'SYNTYVYYSLUKU'."@fi, "USE FOR INFORMATION ABOUT INDIVIDUAL BIRTHS. DO NOT CONFUSE WITH 'NUMBER OF BIRTHS' OR 'BIRTH RATE'."@en,
    "À UTILISER POUR LES INFORMATIONS SUR LES NAISSANCES INDIVIDUELLES. NE PAS CONFONDRE AVEC \"NOMBRE DE NAISSANCES\" OU \"TAUX DE NATALITÉ\"."@fr,
    "NAUDOKITE INFORMACIJAI APIE ATSKIRUS GIMIMUS. NEPAINIOTI SU TERMINAIS \"GIMIMŲ SKAIČIUMI\" ARBA \"GIMSTAMUMO RODIKLIS\"."@lt,
    "ΧΡΗΣΙΜΟΠΟΙΗΣΤΕ TON ΟΡΟ ΓΙΑ ΜΕΜΟΝΩΜΕΝΕΣ ΓΕΝΝΗΣΕΙΣ. ΝΑ ΜΗΝ  ΣΥΓΧΕΕΤΑΙ ΜΕ 'ΑΡΙΘΜΟ ΓΕΝΝΗΣΕΩΝ' Ή ΤΟΝ 'ΔΕΙΚΤΗ ΓΕΝΝΗΤΙΚΟΤΗΤΑΣ'"@el,
    "SE UTILIZA PARA INFORMACIÓN SOBRE NACIMIENTOS INDIVIDUALES. NO CONFUNDIR CON \"NÚMERO DE NACIMIENTOS\" O \"TASA DE NATALIDAD\"."@es,
    "BRUKES FOR INFORMASJON OM INDIVIDUELLE FØDSLER. MÅ IKKE FORVEKSLES MED 'FØDSELSTALL' ELLER 'FØDSELSRATE'."@no,
    "TE GEBRUIK VOOR INFORMATIE OVER INDIVIDUELE GEBOORTEN. NIET VERWARREN MET ‘AANTAL GEBOORTEN’ OF ‘GEBOORTECIJFER’."@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
