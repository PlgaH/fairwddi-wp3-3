<https://elsst.cessda.eu/id/6/715da575-f07a-4cae-ae19-1fe7aec06992> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/715da575-f07a-4cae-ae19-1fe7aec06992>;
  skos:definition "ANTAL SKILSMÄSSOR I FÖRHÅLLANDE TILL TOTALBEFOLKNINGEN, VANLIGTVIS BERÄKNAT PER TUSEN GIFTA PAR."@sv,
    "AVIOEROJEN MÄÄRÄ VUODESSA SUHTEUTETTUNA VÄKILUKUUN, YLEENSÄ 1000 AVIOPARIA KOHDEN."@fi,
    "RAPORTUL NUMĂRULUI DE DIVORȚURI DINTR-O POPULAȚIE CALCULAT, DE OBICEI, LA 1000 DE CASĂTORII (CUPLURI CĂSĂTORITE). A NU SE CONFUNDA CU 'DIVORȚ' SAU CU 'NUMĂRUL DIVORȚURILOR'."@ro,
    "THE RATIO OF THE NUMBER OF DIVORCES TO THE SIZE OF A POPULATION IN A GIVEN PERIOD, USUALLY EXPRESSED AS THE NUMBER OF DIVORCES PER 1,000 OF POPULATION PER YEAR"@en,
    "DAS VERHÄLTNIS ZWISCHEN DER ZAHL DER EHESCHEIDUNGEN UND DER GRÖSSE EINER BEVÖLKERUNG INNERHALB EINES BESTIMMTEN ZEITRAUMS, IN DER REGEL AUSGEDRÜCKT ALS ZAHL DER SCHEIDUNGEN PRO TAUSEND EINWOHNER PRO JAHR"@de,
    "RAPPORT ENTRE LE NOMBRE DE DIVORCES ET LA TAILLE D'UNE POPULATION AU COURS D'UNE PÉRIODE DONNÉE, GÉNÉRALEMENT EXPRIMÉ EN NOMBRE DE DIVORCES POUR 1'000 PERSONNES PAR AN."@fr,
    "IŠTUOKŲ SKAIČIAUS SANTYKIS SU POPULIACIJOS DYDŽIU PER TAM TIKRĄ LAIKOTARPĮ, PAPRASTAI IŠREIŠKIAMAS SANTUOKŲ NUTRAUKIMŲ SKAIČIUMI 1000 GYVENTOJŲ PER METUS."@lt,
    "Ο ΛΟΓΟΣ ΤΟΥ ΑΡΙΘΜΟΥ ΤΩΝ ΔΙΑΖΥΓΙΩΝ ΠΡΟΣ ΤΟ ΜΕΓΕΘΟΣ ΤΟΥ ΠΛΗΘΥΣΜΟΥ ΣΕ ΜΙΑ ΔΕΔΟΜΕΝΗ ΠΕΡΙΟΔΟ ΠΟΥ ΣΥΝΗΘΩΣ ΕΚΦΡΑΖΕΤΑΙ ΩΣ Ο ΑΡΙΘΜΟΣ ΔΙΑΖΥΓΙΩΝ ΑΝΑ 1.000 ΚΑΤΟΙΚΟΥΣ ΑΝΑ ΕΤΟΣ"@el,
    "LA RELACIÓN ENTRE EL NÚMERO DE DIVORCIOS Y EL TAMAÑO DE UNA POBLACIÓN EN UN PERIODO DETERMINADO. NORMALMENTE SE EXPRESA COMO EL NÚMERO DE DIVORCIOS POR CADA 1.000 HABITANTES AL AÑO."@es,
    "FORHOLDET MELLOM ANTALL SKILSMISSER OG STØRRELSEN PÅ EN BEFOLKNING I EN GITT PERIODE, VANLIGVIS UTTRYKT SOM ANTALL SKILSMISSER PER 1 000 INNBYGGERE PER ÅR."@no,
    "RAZMERJE MED ŠTEVILOM RAZVEZ IN VELIKOSTJO POPULACIJE V DOLOČENEM ČASOVNEM OBDOBJU, NAVADNO IZRAŽENO KOT ŠTEVILO LOČITEV NA 1.000 PREBIVALCEV LETNO"@sl,
    "DE VERHOUDING TUSSEN HET AANTAL ECHTSCHEIDINGEN EN DE GROOTTE VAN DE BEVOLKING IN EEN BEPAALDE PERIODE, MEESTAL UITGEDRUKT ALS HET AANTAL ECHTSCHEIDINGEN PER 1.000 INWONERS PER JAAR."@nl;
  skos:scopeNote "BITTE NICHT MIT DEN BEGRIFFEN 'SCHEIDUNG' UND 'SCHEIDUNGSZAHL' VERWECHSELN."@de,
    "DO NOT CONFUSE WITH 'DIVORCE' OR 'NUMBER OF DIVORCES'."@en, "EI TULE SEKOITTAA TERMEIHIN 'AVIOERO' TAI 'AVIOEROJEN MÄÄRÄ'."@fi,
    "MÅ IKKE FORVEKSLES MED ”SKILSMISSE” ELLER ”ANTALL SKILSMISSER”"@no, "NEPAINIOTI SU „IŠTUOKA“ AR „IŠTUOKŲ SKAIČIUS“."@lt,
    "NIET VERWARREN MET 'ECHTSCHEIDING' OF 'AANTAL ECHTSCHEIDINGEN'."@nl, "SKALL EJ BLANDAS IHOP MED ”SKILSMÄSSA” ELLER ”ANTAL SKILSMÄSSOR”."@sv,
    "NE PAS CONFONDRE AVEC \"DIVORCE\" OU \"NOMBRE DE DIVORCES\"."@fr, "NO CONFUNDIR CON LOS TÉRMINOS \"DIVORCIO\" Y \"NÚMERO DE DIVORCIOS\""@es;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "DIVORCE RATE"@en, "ERONNEISUUSLUKU"@fi, "RATA DIVORȚIALITĂȚII"@ro,
