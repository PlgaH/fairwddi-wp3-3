<https://elsst.cessda.eu/id/6/f0c23a85-46b7-4fbe-afdf-345818362649> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/f0c23a85-46b7-4fbe-afdf-345818362649>;
  skos:definition "CAPACITATEA BIOLOGICĂ DE REPRODUCERE A INDIVIZILOR ȘI POPULAȚIILOR (CODS). A NU SE CONFUNDA CU 'FERTILITATEA' ȘI 'RATA NATALITĂȚII' CARE SE REFERĂ LA NAȘTEREA COPIILOR."@ro,
    "NAISTEN JA MIESTEN KYKY LISÄÄNTYÄ ELI SAADA AIKAAN RASKAUS JA LAPSEN SYNTYMÄ"@fi,
    "ABILITY TO CONCEIVE A CHILD, IN BOTH MEN AND WOMEN"@en, "DIE FÄHIGKEIT, EIN KIND ZU ZEUGEN, SOWOHL BEI MÄNNERN ALS AUCH BEI FRAUEN"@de,
    "FÖRMÅGAN ATT BEFRUKTAS OCH FORTPLANTA SIG. GÄLLER BÅDE KVINNOR OCH MÄN."@sv, "CAPACITÉ DE CONCEVOIR UN ENFANT, CHEZ LES FEMMES ET LES HOMMES"@fr,
    "Η ΙΚΑΝΟΤΗΤΑ ΣΥΛΛΗΨΗΣ ΠΑΙΔΙΟΥ ΣΕ ΑΝΤΡΕΣ ΚΑΙ ΓΥΝΑΙΚΕΣ"@el, "GETA TIL AÐ GETA BARN, BÆÐI HJÁ KÖRLUM OG KONUM"@is,
    "VYRŲ IR MOTERŲ GEBĖJIMAS SUSILAUKTI VAIKO."@lt, "SCHOPNOST MUŽŮ A ŽEN POČÍT DÍTĚ"@cs,
    "VERMOGEN OM EEN KIND TE VERWEKKEN, BIJ ZOWEL MANNEN ALS VROUWEN"@nl, "EVNEN TIL Å UNNFANGE ET BARN, FOR BÅDE MENN OG KVINNER"@no,
    "LA CAPACIDAD DE CONCEBIR UN HIJO O HIJA, TANTO EN HOMBRES COMO EN MUJERES"@es, "ZMOŽNOST SPOČETI OTROKA, MOŠKEGA IN ŽENSKE"@sl;
  skos:scopeNote "BITTE NICHT MIT DEN BEGRIFFEN 'FERTILITÄTSRATE' UND 'GEBURTENRATE' VERWECHSELN, DIE SICH AUF TATSÄCHLICHE SCHWANGERSCHAFTEN UND GEBURTEN BEZIEHEN."@de,
    "DO NOT CONFUSE WITH 'FERTILITY RATE' AND 'BIRTH RATE' WHICH REFER TO ACTUAL CHILDBEARING."@en,
    "EI TULE SEKOITTAA TERMEIHIN 'HEDELMÄLLISYYSLUKU' TAI 'SYNTYVYYSLUKU', JOTKA VIITTAAVAT TILASTOTIETOIHIN."@fi,
    "MÅ IKKE FORVEKSLES MED ”FERTILITETSRATE” OG ”FØDSELSRATE” SOM REFERER TIL FAKTISK BARNEFØDSEL."@no,
    "NE PAS CONFONDRE AVEC 'TAUX DE FÉCONDITÉ' ET 'TAUX DE NATALITÉ' QUI FONT RÉFÉRENCE AUX NAISSANCES EFFECTIVES DANS UNE POPULATION."@fr,
    "NEPAINIOTI SU „GIMSTAMUMO LYGIS“ IR „GIMSTAMUMO RODIKLIS“, KURIE SUSIJĘ SU VAIKO GIMDYMU."@lt,
    "NIET VERWARREN MET 'VRUCHTBAARHEIDSCIJFER' EN 'GEBOORTECIJFER', DIE BETREKKING HEBBEN OP HET DAADWERKELIJK DRAGEN VAN KINDEREN."@nl,
    "NO CONFUNDIR CON LOS TÉRMINOS \"TASA DE FERTILIDAD\" Y \"TASA DE NATALIDAD\", QUE SE REFIEREN A LA NATALIDAD REAL."@es,
    "SKA INTE BLANDAS IHOP MED 'FERTILITET' OCH 'FÖDELSETAL', SOM GÄLLER BARNAFÖDANDE."@sv;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "FECUNDITATE"@ro, "FERTILIDAD (HUMANA)"@es, "FERTILITÄT (MENSCH)"@de,
    "FERTILITÉ (HUMAINE)"@fr, "FERTILITY (HUMAN)"@en, "FRJÓSEMI"@is, "FRUKTBARHET"@no,
    "FRUKTSAMHET"@sv, "HEDELMÄLLISYYS (IHMISILLÄ)"@fi, "PLODNOST (PRI LJUDEH)"@sl, "TERMÉKENYSÉG"@hu,
    "VRUCHTBAARHEID (MENS)"@nl, "ΓΟΝΙΜΟΤΗΤΑ"@el, "VAISINGUMAS (ŽMONIŲ)"@lt, "PLODNOST (LIDSKÁ)"@cs;
  skos:altLabel "FÉCONDITÉ (HUMAINE)"@fr, "FEKUNDITET"@no, "FERTILITAET (MENSCH)"@de,
    "FERTILITEETTI (IHMISILLÄ)"@fi, "FERTILITET"@no, "FORTPFLANZUNGSFAEHIGKEIT (MENSCH)"@de,
    "FORTPFLANZUNGSFÄHIGKEIT (MENSCH)"@de, "FRUCHTBARKEIT (MENSCH)"@de, "FRUKTBARHET"@sv,
    "IHMISTEN HEDELMÄLLISYYS (HAVAITTAVA)"@fi, "INFERTILITATE"@ro, "PLODNOST"@sl, "ΑΤΕΚΝΙΑ"@el,
    "ΣΤΕΙΡΟΤΗΤΑ"@el, "VAISINGUMAS"@lt;
  skos:historyNote "BEGRIFF UMBENANNT IM APRIL 2018. VORHER WURDE DER BEGRIFF 'FEKUNDITÄT' BENUTZT. BEGRIFF UMBENANNT IM MAI 2023. VORHER WURDE DER BEGRIFF 'FERTILITÄT' BENUTZT."@de,
    "TERM ENDRET MAI 2023. TIDLIGERE VILLE TERMEN «FERTILITET» HA BLITT BRUKT."@no, "TERM RELABELLED APRIL 2018. PREVIOUSLY THE TERM 'FECUNDITY' WOULD HAVE BEEN USED. TERM RELABELLED MAY 2023. PREVIOUSLY THE TERM 'FERTILITY' WOULD HAVE BEEN USED."@en,
    "TERME RELABELLISÉ EN AVRIL 2018. AUPARAVANT LE TERME 'FÉCONDITÉ' ÉTAIT UTILISÉ. TERME RELABELLISÉ EN MAI 2023. AUPARAVANT LE TERME 'FERTILITÉ' ÉTAIT UTILISÉ"@fr,
    "TÉRMINO RECATALOGADO EN ABRIL DE 2018. ANTES SE UTILIZABA EL TÉRMINO \"FECUNDIDAD\". TÉRMINO RECATALOGADO EN MAYO DE 2023 ANTERIORMENTE SE UTILIZABA EL TÉRMINO \"FERTILIDAD\""@es,
    "TERMINAS PERVADINTAS 2018 M. ANKSČIAU BUVO NAUDOJAMAS TERMINAS \"VAISINGUMAS\". TERMINAS 'VAISINGUMAS' IKI 2019 M. BUVO VERČIAMAS 'GIMSTAMUMAS (DEMOGRAFIJA)'."@lt,
    "TERM OPNIEUW GELABELD APRIL 2018 EN OPNIEUW IN MEI 2023. "@nl;
