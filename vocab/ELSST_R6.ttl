    "ELGSENOS MOKSLAI"@lt, "GEDRAGSWETENSCHAPPEN"@nl, "KÄYTTÄYTYMISTIETEET"@fi, "SCIENCES DU COMPORTEMENT"@fr,
    "ȘTIINȚE COMPORTAMENTALE"@ro, "VEDENJSKA ZNANOST"@sl, "VERHALTENSWISSENSCHAFTEN"@de,
