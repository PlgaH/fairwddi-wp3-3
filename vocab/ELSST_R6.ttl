    "NO CONFUNDIR CON \"UNIÓN CIVIL\" O \"NÚMERO DE UNIONES CIVILES\"."@es, "MÅ IKKE FORVEKSLES MED 'REGISTRERT PARTNERSKAP' ELLER 'ANTALL REGISTRERTE PARTNERSKAP'."@no,
