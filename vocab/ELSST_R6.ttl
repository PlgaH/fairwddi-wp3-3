    "PREŽIVNINA ZA OTROKA"@sl, "UNDERHÅLLSBIDRAG TILL BARN"@sv, "VAIKO IŠLAIKYMO PINIGAI"@lt,
    "VÝŽIVNÉ NA DÍTĚ"@cs, "ΔΙΑΤΡΟΦΗ ΓΙΑ ΤΕΚΝΑ (ΔΙΑΖΥΓΙΟ)"@el;
  skos:altLabel "ALIMENTE (KIND)"@de, "CHILD MAINTENANCE AGREEMENTS"@en, "CHILD MAINTENANCE PAYMENTS"@en,
