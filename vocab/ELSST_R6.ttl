  skos:definition "DE PLAATS OF POSITIE DIE DOOR EEN BEPAALD DING WORDT INGENOMEN"@nl,
    "DEN PLATS ELLER POSITION DÄR NÅGOT ANGIVET FINNS."@sv, "DER ORT, AN DEM SICH EINE BESTIMMTE SACHE BEFINDET."@de,
    "EL LUGAR O LA POSICIÓN QUE OCUPA UNA COSA DETERMINADA"@es, "LOCUL SAU POZIȚIA PE CARE DIVERSE LUCRURI LE OCUPĂ. A SE FOLOSI UN TERMEN MAI SPECIFIC ATUNCI CÂND ESTE CAZUL. "@ro,
    "PLACE OU POSITION OCCUPÉE PAR UNE CHOSE SPÉCIFIQUE. "@fr, "STEDET ELLER POSISJONEN DER NOE BEFINNER SEG. "@no,
    "THE PLACE OR POSITION OCCUPIED BY SOME SPECIFIED THING"@en, "VIETA, KURIOJE IŠSIDĖSTĘ TAM TIKRI KONKRETŪS DAIKTAI."@lt;
  skos:scopeNote "ANVÄND OM MÖJLIGT EN MER SPECIFIK TERM."@sv, "VERWENDEN SIE, WENN MÖGLICH, EINEN GENAUEREN BEGRIFF (UNTERBEGRIFF)."@de,
    "EN LO POSIBLE, UTILIZAR UN TÉRMINO MÁS ESPECÍFICO"@es, "UTILISER SI POSSIBLE UN TERME PLUS SPÉCIFIQUE."@fr,
    "KÄYTÄ TARKEMPAA TERMIÄ MIKÄLI MAHDOLLISTA."@fi, "CONSIDER USING A MORE SPECIFIC TERM."@en,
    "APSVARSTYKITE GALIMYBĘ NAUDOTI KONKRETESNĮ TERMINĄ."@lt;
