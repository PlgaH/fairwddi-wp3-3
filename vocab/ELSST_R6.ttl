  skos:definition "ABARCA CUALQUIER TIPO DE VIAJE INTERNACIONAL"@es, "COUVRE TOUT TYPE DE VOYAGE INTERNATIONAL"@fr,
    "COVERS ANY TYPE OF INTERNATIONAL TRAVEL"@en, "DEKKER ALLE TYPER INTERNASJONALE REISER"@no,
    "GÄLLER ALLA TYPER AV INTERNATIONELLA RESOR."@sv, "HEEFT BETREKKING OP ELK TYPE VAN INTERNATIONALE REIZEN"@nl,
    "SCHLIESST ALLE ARTEN INTERNATIONALER REISETÄTIGKEIT EIN."@de, "ZAJEMA KATERIKOLI TIP MEDNARODNEGA PROMETA"@sl,
    "APIMA VISŲ RŪŠIŲ TARPTAUTINES KELIONES."@lt;
  skos:scopeNote "ANVÄND TERMEN 'UTLANDSSEMESTRAR' FÖR SEMESTERRESOR UTOMLANDS."@sv,
    "FOR FERIEREISER TIL UTLANDET BRUK TERMEN 'UTENLANDSFERIE'"@no, "FOR TRAVELLING ABROAD ON HOLIDAY USE THE TERM 'HOLIDAYS ABROAD'."@en,
    "FÜR ERHOLUNGSURLAUB IM AUSLAND BITTE DEN BEGRIFF 'URLAUB IM AUSLAND' VERWENDEN."@de,
    "KELIAVIMUI ATOSTOGAUTI Į UŽSIENĮ APIBŪDINTI NAUDOKITE TERMINĄ „ATOSTOGOS UŽSIENYJE“."@lt,
    "PARA VIAJES AL EXTRANJERO DE VACACIONES, UTILIZAR EL TÉRMINO \"VACACIONES EN EL EXTRANJERO\"."@es,
    "POUR VOYAGER À L'ÉTRANGER EN VACANCES, UTILISEZ LE TERME 'VACANCES À L'ÉTRANGER'."@fr,
    "TÄTÄ TERMIÄ KÄYTETÄÄN MINKÄ TYYPPISIIN ULKOMAANMATKOIHIN TAHANSA. KUITENKIN VIITATTAESSA LOMANVIETTOON ULKOMAILLA, KÄYTÄ TERMIÄ 'ULKOMAANMATKAILU”."@fi,
    "VOOR VAKANTIES NAAR HET BUITENLAND MAAK GEBRUIK VAN DE TERM 'VAKANTIE IN HET BUITENLAND'."@nl;
