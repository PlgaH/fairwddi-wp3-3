<https://elsst.cessda.eu/id/6/c2063c20-6718-4b32-9bce-81830bf1f384> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/c2063c20-6718-4b32-9bce-81830bf1f384>;
  skos:definition "ACEST TERMEN SE FOLOSEȘTE PENTRU NIVELURILE 3 ȘI 4 DIN ISCED. PENTRU  NIVELUL 5 DIN ISCEL FOLOSIȚI 'INSTITUȚII DE ÎNVĂȚĂMÂNT SUPERIOR'. "@ro,
    "CE TERME EST UTILISÉ POUR LES NIVEAUX ISCED 3 ET 4. POUR LE NIVEAU 5, UTILISEZ LE TERME 'ÉTABLISSEMENTS D'ÉDUCATION SUPÉRIEUR'."@fr,
    "DEN HÄR TERMEN ANVÄNDS FÖR UTBILDNINGSINSTITUT PÅ ISCED-NIVÅ 3 OCH 4."@sv, "DEZE TERM WORDT GEBRUIKT VOOR INSTELLINGEN VAN ISCED NIVEAU 3 EN ISCED NIVEAU 4"@nl,
    "DIESER BEGRIFF BEZIEHT SICH AUF INSTITUTIONEN DER ISCED-EBENEN 3 UND 4."@de, "ESTE TÉRMINO SE UTILIZA PARA LAS INSTITUCIONES DE NIVEL 3 Y 4 DE LA CINE."@es,
    "ISCED-KOULUTUSLUOKITUKSEN KOULUTUSASTEEN 3 JA 4 OPPILAITOKSET."@fi, "ŠIS TERMINAS APIBŪDINA TARPTAUTINĖS STANDARTIZUOTOS ŠVIETIMO KLASIFIKACIJOS (ISCED) 3 IR 4 LYGIO ĮSTAIGAS."@lt,
    "TERMEN ER BRUKT FOR ISCED NIVÅ 3 OG ISCED NIVÅ 4 INSTITUSJONER"@no, "THIS TERM IS USED FOR ISCED LEVEL 3 AND ISCED LEVEL 4 INSTITUTIONS."@en;
  skos:scopeNote "5 LYGMENS ISCED INSTITUCIJOMS APIBŪDINTI, NAUDOKITE TERMINĄ „AUKŠTOJO MOKSLO ĮSTAIGOS“."@lt,
    "ANVÄND 'INSTITUTIONER FÖR HÖGRE UTBILDNING' FÖR INSTITUTIONER PÅ ISCED-NIVÅ 5."@sv,
    "FOR ISCED LEVEL 5 INSTITUTIONS USE 'HIGHER EDUCATION INSTITUTIONS'."@en, "FOR ISCED NIVÅ 5 INSITUSJONER BRUK 'HØYERE UTDANNINGSINSTITUSJONER'"@no,
    "FÜR INSTITUTIONEN DER ISCED-EBENE 5 BITTE DEN BEGRIFF 'EINRICHTUNGEN FÜR HÖHERE BILDUNG' VERWENDEN."@de,
    "KOULUTUSASTEEN 5 OPPILAITOKSISTA KÄYTÄ TERMIÄ 'KORKEAKOULUT'."@fi, "PARA LAS INSTITUCIONES DE NIVEL 5 DE LA CINE UTILIZAR EL TÉRMINO \"INSTITUCIONES DE ENSEÑANZA SUPERIOR\"."@es,
    "POUR ISCED NIVEAU 5, UTILISER LE TERME 'ÉTABLISSEMENTS D'ENSEIGNEMENT SUPÉRIEUR'"@fr,
    "VOOR INSTELLINGEN VAN ISCED NIVEAU 5 GEBRUIK 'INSTELLINGEN VOOR HOGER ONDERWIJS'"@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
