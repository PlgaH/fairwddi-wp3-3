<https://elsst.cessda.eu/id/6/eb6086fe-4d1f-4787-8c26-b1ff0d36c028> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/eb6086fe-4d1f-4787-8c26-b1ff0d36c028>;
  skos:scopeNote "A NU SE CONFUNDA CU 'MORTALITATE' SAU 'RATA MORTALITĂȚII'"@ro, "EI TULE SEKOITTAA TERMEIHIN 'KUOLEMIEN MÄÄRÄ' TAI 'KUOLLEISUUSLUKU'."@fi,
    "SKA INTE FÖRVÄXLAS MED \"DÖDLIGHET\" ELLER \"DÖDSTAL\"."@sv, "DO NOT CONFUSE WITH 'NUMBER OF DEATHS' OR 'MORTALITY RATE'."@en,
    "BITTE NICHT MIT DEN BEGRIFFEN 'STERBEFÄLLE' ODER 'STERBERATE' VERWECHSELN."@de, "NE PAS CONFONDRE AVEC \"NOMBRE DE DÉCÈS\" OU \"TAUX DE MORTALITÉ\"."@fr,
    "NEPAINIOTI SU TERMINAIS \"MIRČIŲ SKAIČIUS\" ARBA \"MIRTINGUMO RODIKLIS\"."@lt, "ΝΑ ΜΗΝ ΣΥΓΧΕΕΤΑΙ ΜΕ ΤΟΝ  'ΑΡΙΘΜΟ ΘΑΝΑΤΩΝ'  Ή ΤΟΝ  'ΔΕΙΚΤΗ ΘΝΗΤΟΤΗΤΑΣ'"@el,
    "ΝΑ ΜΗΝ ΣΥΓΧΕΕΤΑΙ ΜΕ ΤΟΥΣ ΟΡΟΥΣ  'ΑΡΙΘΜΟΣ ΘΑΝΑΤΩΝ' Ή 'ΔΕΙΚΤΗΣ ΘΝΗΣΙΜΟΤΗΤΑΣ'"@el, "NO CONFUNDIR CON LOS TÉRMINOS \"NÚMERO DE MUERTES\" O \"TASA DE MORTALIDAD\"."@es,
    "MÅ IKKE FORVEKSLES MED 'ANTALL DØDSFALL' ELLER 'MORTALITETSRATE'"@no, "NIET TE VERWARREN MET ‘AANTAL STERFGEVALLEN’ OF ‘STERFTECIJFER’."@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "DAUÐI"@is, "DEATH"@en, "DÉCÈS"@fr, "DECES"@ro, "DØD"@no, "DÖD"@sv,
    "DOOD"@nl, "HALÁL"@hu, "KUOLEMA"@fi, "MIRTIS"@lt, "MUERTE"@es, "SMRT"@cs, "SMRT"@sl,
