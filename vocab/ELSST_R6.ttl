<https://elsst.cessda.eu/id/6/74399e67-a46b-4dee-adf7-72adb5a02022> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/74399e67-a46b-4dee-adf7-72adb5a02022>;
  skos:definition "COMPREND LES FORMATIONS DANS LE COMMERCE DE DÉTAILS, LE MARKETING, L'IMMOBILIER, LA FINANCE, LA BANQUE, LE MANAGEMENT, L'ADMINISTRATION, LA COMPTABILITÉ, LE SECRÉTARIAT."@fr,
    "DEZE TERM OMVAT DETAILHANDEL, MARKETING, ONROEREND GOED, FINANCIËN, BANKWEZEN, MANAGEMENT, ADMINISTRATIE, ADMINISTRATIE, BOEKHOUDING, SECRETARIEEL EN ADMINISTRATIEF ONDERWIJS"@nl,
    "ESTE TÉRMINO ABARCA EL COMERCIO MINORISTA, EL MARKETING, EL SECTOR INMOBILIARIO, LAS FINANZAS, LA BANCA, LA GESTIÓN, LA ADMINISTRACIÓN, LA CONTABILIDAD Y LA FORMACIÓN DE OFICINISTAS Y SECRETARIAS."@es,
    "KATTAA VÄHITTÄISKAUPPA-ALAN, KIINTEISTÖNVÄLITYKSEN, RAHOITUS- JA PANKKIALAN, HALLINTOTIETEET, KIRJANPIDON, SIHTEERIALAN JA MUUN TOIMISTOTYÖN."@fi,
    "TERMEN DEKKER DETALJHANDEL, MARKEDSFØRING, EIENDOMSMEGLING, FINANS, BANK, LEDELSE, ADMINISTRASJON, REGNESKAP, SEKRETÆR- OG KONTORUTDANNING"@no,
    "TERMEN GÄLLER UTBILDNINGAR INOM HANDEL, MARKNADSFÖRING, FASTIGHETER, BANKVÄSEN, LEDNING, ADMINISTRATION, REDOVISNING, SEKRETERAR- OCH KONTORSUTBILDNINGAR."@sv,
    "THIS TERM COVERS RETAIL, MARKETING, REAL ESTATE, FINANCE, BANKING, MANAGEMENT, ADMINISTRATION, ACCOUNTING, SECRETARIAL AND CLERICAL EDUCATION."@en,
    "UMFASST DIE BEREICHE EINZELHANDEL, VERMARKTUNG (MARKETING), IMMOBILIENHANDEL, FINANZEN, BANKWESEN, UNTERNEHMENSFÜHRUNG (MANAGEMENT), VERWALTUNG (ADMINISTRATION), BUCHHALTUNG, SEKRETARIAT UND BÜROARBEIT."@de,
    "APIMA MAŽMENINĘ PREKYBĄ, RINKODARĄ, NEKILNOJAMĄ TURTĄ, FINANSUS, BANKININKYSTĘ, VADYBĄ, ADMINSITRAVIMĄ, BUHALTERIJĄ, SEKRETORIŲ IR RAŠTVEDŽIŲ MOKYMĄ."@lt;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
