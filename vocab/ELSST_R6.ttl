<https://elsst.cessda.eu/id/6/d8f31e43-68d0-4b17-a33e-9fee3c5f77b3> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/d8f31e43-68d0-4b17-a33e-9fee3c5f77b3>;
  skos:definition "ANTAL FÖDSLAR UNDER EN GIVEN PERIOD."@sv, "NUMĂRUL NAȘTERILOR DINTR-O ANUMITĂ PERIOADĂ. A NU SE CONFUNDA CU 'NAȘTERE' ORI CU 'RATA NATALITĂȚII'."@ro,
    "SYNTYMÄT TIETTYNÄ AJANJAKSONA."@fi, "Ο ΑΡΙΘΜΟΣ ΤΩΝ ΓΕΝΝΗΣΕΩΝ ΣΕ ΜΙΑ ΣΥΓΚΕΚΡΙΜΕΝΗ ΧΡΟΝΙΚΗ ΠΕΡΙΟΔΟ. ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΕ ΜΕ ΤΟΥΣ ΟΡΟΥΣ 'ΓΕΝΝΗΣΗ' Ή 'ΓΟΝΙΜΟΤΗΤΑ'."@el,
    "NUMBER OF LIVE BIRTHS IN A POPULATON IN A GIVEN PERIOD"@en, "ANZAHL DER LEBENDGEBURTEN IN EINER POPULATION INNERHALB EINES BESTIMMTEN ZEITRAUMES."@de,
    "NOMBRE DE NAISSANCES VIVANTES DANS UNE POPULATION AU COURS D'UNE PÉRIODE DONNÉE"@fr,
    "GYVAGIMIŲ SKAIČIUS SKAIČIUS POPULIACIJOJE PER TAM TIKRĄ LAIKOTARPĮ."@lt, "NÚMERO DE NACIDOS VIVOS DE UNA POBLACIÓN EN UN PERIODO DETERMINADO"@es,
    "ANTALL LEVENDEFØDSLER I EN BEFOLKNING I EN GITT PERIODE"@no, "AANTAL LEVEND GEBOORTES IN EEN POPULATIE IN EEN BEPAALDE PERIODE"@nl;
  skos:scopeNote "BITTE NICHT MIT DEN BEGRIFFEN 'GEBURT' UND 'GEBURTENRATE' VERWECHSELN."@de,
    "DO NOT CONFUSE WITH 'CHILDBIRTH' OR 'BIRTH RATE'."@en, "EI TULE SEKOITTAA TERMEIHIN 'SYNTYMÄ' TAI 'SYNTYVYYSLUKU'."@fi,
    "MÅ IKKE FORVEKSLES MED 'BARNEFØDSEL' ELLER 'FØDSELSRATE'"@no, "NE PAS CONFONDRE AVEC 'NAISSANCE' OU 'TAUX DE NATALITÉ'"@fr,
    "NO CONFUNDIR CON \"NACIMIENTO\" O \"TASA DE NATALIDAD\"."@es, "SKA INTE BLANDAS IHOP MED MED 'BARNAFÖDSEL' ELLER 'FÖDELSETAL'."@sv,
    "NEPAINIOTI SU TERMINAIS \"VAIKO GIMIMAS“ IR \"GIMSTAMUMO RODIKLIS“."@lt, "NIET VERWARREN MET 'BEVALLING' OF 'GEBOORTECIJFER'"@nl;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "NOMBRE DE NAISSANCES"@fr, "HLUTFALL FÆÐINGA Á ÁRI MIÐAÐ VIÐ ÍBÚATÖLU"@is,
    "NATALITA"@cs, "NATALITATE"@ro, "NATIVITET"@sv, "SYNTYMIEN MÄÄRÄ"@fi, "SZÜLETÉSSZÁM"@hu,
    "GEBURTENZAHL"@de, "NUMBER OF BIRTHS"@en, "ΑΡΙΘΜΟΣ ΓΕΝΝΗΣΕΩΝ"@el, "GYVAGIMIŲ SKAIČIUS"@lt,
    "NÚMERO DE NACIMIENTOS"@es, "FØDSELSTALL"@no, "ŠTEVILO ROJSTEV"@sl, "AANTAL GEBOORTES"@nl;
  skos:altLabel "ANTAL FÖDSLAR"@sv, "ANTALL FØDSLER"@no, "GEBORENENZAHL"@de, "GEBURTEN (ANZAHL)"@de,
    "NUMĂRUL NAȘTERILOR"@ro, "PORODNOST"@cs, "SYNTYMIEN LUKUMÄÄRÄ"@fi, "NOMBRE DE NAISSANCES VIVANTES"@fr,
    "NÚMERO DE NACIDOS VIVOS"@es;
  skos:historyNote "TERM RELABELLED 2025. PREVIOUSLY THE TERM 'NATALITY' WOULD HAVE BEEN USED. THE DEFINITION WAS CHANGED TO REFER TO 'NUMBER OF LIVE BIRTHS' RATHER THAN 'NUMBER OF BIRTHS', AND 'NATALITY' BECAME AN ENTRY TERM OF 'BIRTH RATE'."@en,
    "BEGRIFF UMBENANNT 2025. VORHER WURDE DER BEGRIFF 'GEBURTENHÄUFIGKEIT' BENUTZT. DIE DEFINITION WURDE GEÄNDERT UND BEZIEHT SICH NUN AUF DIE 'ZAHL DER LEBENDGEBURTEN' UND NICHT MEHR AUF DIE 'ZAHL DER GEBURTEN'. 'GEBURTENHÄUFIGKEIT' WURDE ZU EINEM ENTRY TERM FÜR DIE 'GEBURTENRATE'."@de,
    "TERMINAS PERVADINTAS 2025 M. ANKSČIAU BUVO NAUDOJAMAS TERMINAS \"GIMSTAMUMAS\". TERMINAS BUVO PAKEISTAS, KAD APIMTŲ \"GYVŲ GIMUSIŲ KŪDIKIŲ SKAIČIŲ\", O NE \"GIMIMŲ SKAIČIŲ\". O \"GIMSTAMUMAS\" TAPO TERMINO „GIMSTAMUMO RODIKLIS“ NUKREIPIAMUOJU TERMINU."@lt,
    "TERME RELABELLISÉ EN 2025. AUPARAVANT, LE TERME \"NATALITÉ\" ÉTAIT UTILISÉ. LA DÉFINITION A ÉTÉ MODIFIÉE POUR FAIRE RÉFÉRENCE AU \"NOMBRE DE NAISSANCES VIVANTES\" PLUTÔT QU'AU \"NOMBRE DE NAISSANCES\", ET \"NATALITÉ\" EST DEVENU UN TERME D'ENTRÉE DE \"TAUX DE NATALITÉ\"."@fr,
    "TÉRMINO RECATALOGADO EN 2025. ANTES SE UTILIZABA EL TÉRMINO “NATALIDAD”. LA DEFINICIÓN SE MODIFICÓ PARA HACER REFERENCIA AL \"NÚMERO DE NACIDOS VIVOS\" EN LUGAR DE AL \"NÚMERO DE NACIMIENTOS\", Y \"NATALIDAD\" PASÓ A SER UN TÉRMINO DE ENTRADA DE \"TASA DE NATALIDAD\"."@es,
    "TERM ENDRET I 2025. TIDLIGERE VILLE TERMEN 'NATALITET' HA BLITT BRUKT. DEFINISJONEN BLE ENDRET FOR Å REFERERE TIL 'ANTALL LEVENDEFØDSLER' I STEDET FOR 'ANTALL FØDSLER', OG 'NATALITET' BLE EN INNGANGSTERM FOR 'FØDSELSRATE'."@no,
    "TERM HERNOEMD IN 2025. VOORHEEN WERD DE TERM ‘GEBOORTECIJFER’ GEBRUIKT. DE DEFINITIE WERD GEWIJZIGD OM TE VERWIJZEN NAAR ‘AANTAL LEVENDGEBOREN KINDEREN’ IN PLAATS VAN ‘AANTAL GEBOORTEN’."@nl;
  skos:broader <https://elsst.cessda.eu/id/6/0ad6c79b-31b7-4601-bf52-fdc88878dc54>;
  skos:narrower <https://elsst.cessda.eu/id/6/4a214e4f-e0f4-43ce-b078-9e92ffd522a5>;
