<https://elsst.cessda.eu/id/6/f538d499-1acd-49fc-ab96-afc2f42856ba> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/f538d499-1acd-49fc-ab96-afc2f42856ba>;
  skos:definition "BEIM TREIBHAUSEFFEKT HANDELT ES SICH UM DIE DURCH TREIBHAUSGASE VERURSACHTE ANSAMMLUNG VON WÄRME IN DEN UNTEREN ATMOSPHÄRESCHICHTEN. "@de,
    "EL EFECTO INVERNADERO CONSISTE EN ATRAPAR EL CALOR EN LOS NIVELES INFERIORES DE LA ATMÓSFERA."@es,
    "HET BROEIKASEFFECT IS HET OPVANGEN VAN WARMTE IN DE LAGERE NIVEAUS VAN DE ATMOSFEER"@nl,
    "SE REFERĂ LA BLOCAREA VALURILOR DE CĂLDURĂ ÎN ZONELE JOASE ALE ATMOSFEREI"@ro, "ŠILTNAMIO EFEKTAS – ŠILUMOS KAUPIMASIS ŽEMESNIUOSE ATMOSFEROS SLUOKSNIUOSE."@lt,
    "THE GREENHOUSE EFFECT IS THE TRAPPING OF HEAT IN THE LOWER LEVELS OF THE ATMOSPHERE."@en,
    "VÄXTHUSEFFEKTEN BESKRIVER HUR VÄRME STANNAR KVAR I DE NEDRE DELARNA AV ATMOSFÄREN"@sv;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
