<https://elsst.cessda.eu/id/6/6952f7f5-d14f-4c24-9ffb-18b46c6d3a82> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/6952f7f5-d14f-4c24-9ffb-18b46c6d3a82>;
  skos:definition "BEZIEHUNGEN ZWISCHEN ARBEITNEHMENDEN ODER GRUPPEN VON ARBEITNEHMENDEN AN IHREM ARBEITSPLATZ."@de,
    "DE BETREKKINGEN TUSSEN WERKNEMERS OF GROEPEN WERKNEMERS OP HUN WERKPLEK"@nl, "FÖRHÅLLANDE MELLAN ANSTÄLLDA ELLER GRUPPER AV ANSTÄLLDA PÅ ARBETSPLATSEN."@sv,
    "FORHOLDET MELLOM ANSATTE ELLER GRUPPER AV ANSATTE PÅ ARBEIDSPLASSEN"@no, "RELACIONES ENTRE TRABAJADORES O GRUPOS DE TRABAJADORES EN EL ENTORNO LABORAL."@es,
    "RELAŢII ÎNTRE MUNCITORI/SALARIAȚI SAU GRUPURI DE ANGAJAȚI LA LOCUL DE MUNCĂ. A NU SE CONFUNDA CU ”RELAȚII DE MUNCĂ”"@ro,
    "RELATIONS BETWEEN WORKERS OR GROUPS OF WORKERS AT THEIR PLACE OF WORK"@en, "RELATIONS ENTRE LES TRAVAILLEURS, OU DES GROUPES DE TRAVAILLEURS AU LIEU DE TRAVAIL. NE PAS CONFONDRE AVEC LE TERME 'RELATIONS DE TRAVAIL”, QUI SE RÉFÈRE AUX RELATIONS PATRONAT-TRAVAILLEURS."@fr,
    "SANTYKIAI TARP DARBUOTOJŲ AR DARBUOTOJŲ GRUPIŲ JŲ DARBO VIETOJE."@lt, "TYÖNTEKIJÖIDEN TAI TYÖNTEKIJÄRYHMIEN VÄLISET SUHTEET TYÖPAIKALLA."@fi;
  skos:scopeNote "ANVÄND TERMEN 'ARBETSMARKNADSRELATIONER' FÖR FÖRHÅLLANDET MELLAN ANSTÄLLDA OCH LEDNING."@sv,
    "DARBO IR (ARBA) VADOVYBĖS SANTYKIAMS NAUDOKITE TERMINĄ „DARBO SANTYKIAI“."@lt, "EI TULE SEKOITTAA TYÖNTEKIJÖIDEN JA TYÖNJOHDON VÄLISIIN SUHTEISIIN, JOITA KUVAA TERMI 'TYÖELÄMÄN SUHTEET'."@fi,
    "FOR LABOUR/MANAGEMENT RELATIONS USE THE TERM 'LABOUR RELATIONS'."@en, "FOR RELASJONER MELLOM LEDELSE OG ANSATTE BRUK TERMEN 'ARBEIDSRELASJONER'."@no,
    "FÜR BEZIEHUNGEN ZWISCHEN ARBEITNEHMENDEN UND MANAGEMENT BITTE DEN BEGRIFF 'ARBEITSBEZIEHUNGEN' VERWENDEN."@de,
    "PARA LAS RELACIONES ENTRE TRABAJADORES Y DIRECTIVOS UTILIZAR EL TÉRMINO \"RELACIONES LABORALES\"."@es,
    "POUR LES RELATIONS DE TRAVAIL/MANAGÉRIALE, UTILISER LE TERME 'RAPPORT DE TRAVAIL'"@fr,
    "VOOR ARBEIDS-/MANAGEMENTRELATIES WORDT DE TERM 'ARBEIDSVERHOUDINGEN' GEBRUIKT."@nl;
