  skos:definition "BEVÖLKERUNGSWANDERUNG VOM LAND IN DIE STADT."@de, "DESPLAZAMIENTO DE LA POBLACIÓN DEL CAMPO HACIA LAS ZONAS URBANAS."@es,
    "INFLYTTNING FRÅN LANDSBYGDEN TILL STÄDER."@sv, "MIGRASJON FRA RURALE TIL URBANE OMRÅDER."@no,
    "MIGRAȚIA POPULAȚIEI DIN ZONELE RURALE CĂTRE ZONELE URBANE. A NU SE CONFUNDA CU 'MIGRAȚIA URBAN-RURAL'"@ro,
    "MIGRATIE VAN DE BEVOLKING VAN HET PLATTELAND NAAR DE STAD"@nl, "POPULATION MIGRATION FROM RURAL TO URBAN AREAS"@en,
    "ΜΕΤΑΚΙΝΗΣΗ ΠΛΗΘΥΣΜΟΥ ΑΠΟ ΑΓΡΟΤΙΚΕΣ ΠΕΡΙΟΧΕΣ ΠΡΟΣ ΑΣΤΙΚΕΣ ΠΕΡΙΟΧΕΣ. ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΕ ΜΕ ΤΟΝ ΟΡΟ 'ΑΣΤΙΚΟΠΟΙΗΣΗ'"@el,
    "GYVENTOJŲ PERSIKĖLIMAS IŠ KAIMO Į MIESTĄ."@lt, "MIGRATION DE LA POPULATION DES ZONES RURALES VERS LES ZONES URBAINES"@fr;
  skos:scopeNote "BITTE NICHT MIT 'STADTFLUCHT' VERWECHSELN."@de, "DO NOT CONFUSE WITH 'COUNTER-URBANIZATION'."@en,
    "MÅ IKKE FORVEKSLES MED ”MOTURBANISERING”."@no, "NE PAS CONFONDRE AVEC 'CONTRE-URBANISATION'"@fr,
    "NEPAINIOTI SU TERMINU „KONTRAURBANIZACIJA“. "@lt, "NIET VERWARREN MET 'ONTSTEDELIJKING'"@nl,
    "NO CONFUNDIR CON EL TÉRMINO \"CONTRA-URBANIZACIÓN\""@es, "SKALL EJ SAMMANBLANDAS MED ”KONTRAURBANISERING”."@sv;
