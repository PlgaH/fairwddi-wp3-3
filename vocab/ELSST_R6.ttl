<https://elsst.cessda.eu/id/6/2d7b6192-0c5f-4fdd-81cb-d9b719c4424a> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/2d7b6192-0c5f-4fdd-81cb-d9b719c4424a>;
  skos:definition "ANTAL SKILSMÄSSOR UNDER EN GIVEN PERIOD."@sv, "AVIOEROJEN MÄÄRÄ TIETTTYNÄ AJANJAKSONA."@fi,
    "NUMĂRUL DIVORȚURILOR DINTR-O ANUMITĂ PERIOADĂ. A NU SE CONFUNDA CU 'DIVORȚ' SAU CU 'RATA DIVORȚURILOR'."@ro,
    "Ο ΑΡΙΘΜΟΣ ΤΩΝ ΔΙΑΖΥΓΙΩΝ ΣΕ ΜΙΑ ΣΥΓΚΕΚΡΙΜΕΝΗ ΧΡΟΝΙΚΗ ΠΕΡΙΟΔΟ. ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΕ ΜΕ ΤΟΥΣ ΟΡΟΥΣ 'ΔΙΑΖΥΓΙΟ' Ή 'ΔΕΙΚΤΗ ΔΙΑΖΥΓΙΩΝ'."@el,
    "NUMBER OF DIVORCES IN A POPULATON IN A GIVEN PERIOD"@en, "ANZAHL VON SCHEIDUNGEN IN EINER BEVÖLKERUNG INNERHALB EINES BESTIMMTEN ZEITRAUMS"@de,
    "NOMBRE DE DIVORCES DANS UNE POPULATION AU COURS D'UNE PÉRIODE DONNÉE"@fr, "IŠTUOKŲ SKAIČIUS POPULIACIJOJE PER TAM TIKRĄ LAIKOTARPĮ."@lt,
    "NÚMERO DE DIVORCIOS EN UNA POBLACIÓN DENTRO DE UN PERIODO DE TIEMPO DETERMINADO."@es,
    "ANTALL SKILSMISSER I EN BEFOLKNING I EN GITT PERIODE."@no, """ŠTEVILO RAZVEZ V POPULACIJI V DOLOČENEM ČASOVNEM OBDOBJU
"""@sl,
    "AANTAL ECHTSCHEIDINGEN IN EEN BEVOLKING IN EEN BEPAALDE PERIODE"@nl;
  skos:scopeNote "DO NOT CONFUSE WITH 'DIVORCE' OR 'DIVORCE RATE'."@en, "EI TULE SEKOITTAA TERMEIHIN 'AVIOERO' TAI 'ERONNEISUUSLUKU'."@fi,
    "MÅ IKKE FORVEKSLES MED ”SKILSMISSE” ELLER ”SKILSMISSERATE”."@no, "NIET VERWARREN MET 'ECHTSCHEIDING'. OF 'ECHTSCHEIDINGSPERCENTAGE'"@nl,
    "NO CONFUNDIR CON LOS TÉRMINOS \"DIVORCIO\" Y \"TASA DE DIVORCIO\""@es, "SKA INTE BLANDAS IHOP MED 'SKILSMÄSSA' ELLER 'SKILSMÄSSOTAL'."@sv,
    "NE PAS CONFONDRE AVEC \"DIVORCE\" ET \"TAUX DE DIVORCE\"."@fr, "NEPAINIOTI SU \"IŠTUOKA\" AR \"IŠTUOKŲ KOEFICIENTAS\"."@lt;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
