<https://elsst.cessda.eu/id/6/e0494036-d1de-4801-aa86-b4e9ed1ec479> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/e0494036-d1de-4801-aa86-b4e9ed1ec479>;
  skos:definition "AL HET WATER DAT VAN NATURE OPENSTAAT VOOR DE ATMOSFEER, MET INBEGRIP VAN RIVIEREN, MEREN, RESERVOIRS, VIJVERS, BEKEN, OPSTUWINGEN, ZEEËN, ESTUARIA EN WETLANDS"@nl,
    "ALL WATER THAT IS NATURALLY OPEN TO THE ATMOSPHERE, INCLUDING RIVERS, LAKES, RESERVOIRS, PONDS, STREAMS, IMPOUNDMENTS, SEAS, ESTUARIES AND WETLANDS"@en,
    "ALLE OBERIRDISCHEN GEWÄSSER, EINSCHLIESSLICH FLÜSSE, SEEN, STAUSEEN, TEICHE, BÄCHE, STAUBECKEN, MEERE, FLUSS- UND MEERESMÜNDUNGEN SOWIE FEUCHTGEBIETE."@de,
    "ALLT VATTEN SOM LIGGER NATURLIGT ÖPPET MOT ATMOSFÄREN, SOM FLODER, SJÖAR, RESERVOARER, TJÄRNAR, ÅAR, UPPDÄMNINGAR, HAV, FLODMYNNINGAR OCH VÅTMARKER."@sv,
    "ALT VANN SOM ER NATURLIG ÅPENT I ATMOSFÆREN, INKLUDERT ELVER, INNSJØER, VANNMAGASIN, DAMMER, BEKKER, SJØER, ELVEMUNNING OG VÅTMARKER"@no,
    "TODO CUERPO DE AGUA QUE ESTÉ NATURALMENTE EXPUESTO A LA ATMÓSFERA, INCLUYENDO RÍOS, LAGOS, EMBALSES, ESTANQUES, ARROYOS, PRESAS, MARES, ESTUARIOS Y HUMEDALES"@es,
    "VISI ATMOSFERAI NATŪRALIAI ATVIRI VANDENYS, ĮSKAITANT UPES, EŽERUS, TVENKINIUS, KŪDRAS, ŠALTINIUS, VANDENS SAUGYKLAS, JŪRAS, ESTUARIJAS (UPŲ ŽIOTIS) IR PELKYNUS."@lt;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
  skos:prefLabel "AGUAS SUPERFICIALES"@es, "APĂ DE SUPRAFAȚĂ"@ro, "EAU DE SURFACE"@fr,
