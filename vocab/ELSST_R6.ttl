  skos:definition "BEVÖLKERUNGSWANDERUNG VON DER STADT AUFS LAND."@de, "MIGRASJON FRA URBANE TIL RURALE OMRÅDER"@no,
    "MIGRAȚIE INTERNĂ DIN ZONELE URBANE CĂTRE ZONELE RURALE"@ro, "MIGRATIE VAN DE BEVOLKING VAN STEDELIJKE GEBIEDEN NAAR PLATTELANDSGEBIEDEN"@nl,
    "POPULATION MIGRATION FROM URBAN AREAS TO RURAL AREAS"@en, "UTFLYTTNING FRÅN STÄDER TILL LANDSBYGDEN."@sv,
    "ΠΛΗΘΥΣΜΙΑΚΗ ΜΕΤΑΝΑΣΤΕΥΣΗ ΑΠΟ ΑΣΤΙΚΕΣ ΠΕΡΙΟΧΕΣ ΠΡΟΣ ΑΓΡΟΤΙΚΕΣ ΠΕΡΙΟΧΕΣ. ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΕ ΜΕ ΤΟΝ ΟΡΟ 'ΑΓΡΟΤΙΚΗ ΜΕΤΑΝΑΣΤΕΥΣΗ'."@el,
    "GYVENTOJŲ PERSIKĖLIMAS IŠ MIESTO Į KAIMĄ."@lt, "MIGRATION DE LA POPULATION DES ZONES URBAINES VERS LES ZONES RURALES"@fr,
    "DESPLAZAMIENTO DE LA POBLACIÓN DE LAS ZONAS URBANAS AL CAMPO"@es;
  skos:scopeNote "BITTE NICHT MIT 'LANDFLUCHT' VERWECHSELN."@de, "SKA INTE BLANDAS IHOP MED ”LANDSBYGDENS AVBEFOLKNING”."@sv,
    "DO NOT CONFUSE WITH 'RURAL-URBAN MIGRATION'."@en, "NEPAINIOTI SU TERMINU \"MIGRACIJA IŠ KAIMO Į MIESTĄ\"."@lt,
    "NE PAS CONFONDRE AVEC \"MIGRATION RURALE-URBAINE\""@fr, "MÅ IKKE FORVEKSLES MED 'RURAL-URBAN MIGRASJON'."@no,
    "NO CONFUNDIR CON EL TÉRMINO \"MIGRACIÓN CAMPO-CIUDAD\""@es, "ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΑΙ ΜΕ ΤΟΝ ΟΡΟ \"ΑΓΡΟΤΙΚΗ-ΑΣΤΙΚΗ ΜΕΤΑΝΑΣΤΕΥΣΗ\""@el,
    "NIET VERWARREN MET ‘PLATTELAND-STADSMIGRATIE’."@nl;
