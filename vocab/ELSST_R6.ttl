<https://elsst.cessda.eu/id/6/478bde4f-bedd-46ec-b84a-145d94f81973> a skos:Concept;
  owl:priorVersion <https://elsst.cessda.eu/id/5/478bde4f-bedd-46ec-b84a-145d94f81973>;
  skos:definition "A NU SE CONFUNDA CU 'RATA DIVORȚURILOR' SAU 'NUMĂRUL DIVORȚURILOR'."@ro,
    "AVIOERO KÄSITTEENÄ TAI YKSITTÄISIÄ AVIOEROJA KOSKEVA INFORMAATIO."@fi, "BEGREPPET SKILSMÄSSA ELLER INFORMATION OM INDIVIDUELLA SKILSMÄSSOR."@sv,
    "BEGRIFF BEZIEHT SICH AUF DAS KONZEPT DER SCHEIDUNG ODER AUF INFORMATION ÜBER EINZELNE SCHEIDUNGSFÄLLE"@de,
    "EL CONCEPTO DE DIVORCIO O LA INFORMACIÓN SOBRE DIVORCIOS PARTICULARES"@es, "HET BEGRIP ECHTSCHEIDING OF INFORMATIE OVER INDIVIDUELE ECHTSCHEIDINGEN"@nl,
    "LE CONCEPT DE DIVORCE OU TOUTE INFORMATION À PROPOS DE DIVORCES INDIVIDUELS"@fr,
    "SKYRYBŲ SĄVOKA ARBA INFORMACIJA APIE KONKREČIAS SKYRYBAS."@lt, "TERMEN DEKKER BEGREPET SKILSMISSE ELLER OPPLYSNINGER OM INDIVIDUELLE SKILSMISSER"@no,
    "THE CONCEPT OF DIVORCE OR INFORMATION ABOUT INDIVIDUAL DIVORCES"@en, "Η ΕΝΝΟΙΑ ΤΟΥ ΔΙΑΖΥΓΙΟΥ Ή ΤΗΣ ΠΛΗΡΟΦΟΡΙΑΣ ΣΧΕΤΙΚΑ ΜΕ ΤΑ ΑΤΟΜΙΚΑ ΔΙΑΖΥΓΙΑ. ΜΗΝ ΤΟ ΣΥΓΧΕΕΤΕ ΜΕ ΤΟΝ 'ΔΕΙΚΤΗ ΔΙΑΖΥΓΙΩΝ' Ή 'ΤΟΝ ΑΡΙΘΜΟ ΤΩΝ ΔΙΑΖΥΓΙΩΝ'"@el;
  skos:scopeNote "BITTE NICHT VERWECHSELN MIT DEN BEGRIFFEN 'SCHEIDUNGSRATE' UND 'SCHEIDUNGSZAHL'."@de,
    "DO NOT CONFUSE WITH 'DIVORCE RATE' OR 'NUMBER OF DIVORCES'."@en, "EI TULE SEKOITTAA TERMEIHIN 'ERONNEISUUSLUKU' TAI 'AVIOEROJEN MÄÄRÄ'."@fi,
    "MÅ IKKE FORVEKSLES MED ”SKILSMISSERATE” ELLER ”ANTALL SKILSMISSER”."@no, "NE PAS CONFONDRE AVEC 'TAUX DE DIVORCE' ET 'NOMBRE DE DIVORCES'"@fr,
    "NEPAINIOTI SU „IŠTUOKŲ KOEFICIENTAS“ AR „IŠTUOKŲ SKAIČIUS“."@lt, "NIET VERWARREN MET 'ECHTSCHEIDINGSPERCENTAGE' OF 'AANTAL ECHTSCHEIDINGEN'."@nl,
    "SKA INTE BLANDAS IHOP MED ”SKILSMÄSSOTAL” ELLER ”ANTAL SKILSMÄSSOR”."@sv, "NO CONFUNDIR CON LOS TÉRMINOS \"TASA DE DIVORCIO\" O \"NÚMERO DE DIVORCIOS\""@es;
  skos:inScheme <https://elsst.cessda.eu/id/6/>;
