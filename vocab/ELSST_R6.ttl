  skos:altLabel "DECESO"@es, "DÖDEN"@sv, "MOARTE"@ro, "MORT"@fr, "DEFUNCIÓN"@es, "FALLECIMIENTO"@es;
  skos:historyNote "TERM CREATED MAY 2021. PREVIOUSLY THE TERM 'BEREAVEMENT' MIGHT HAVE BEEN USED."@en,
    "TERM ERSTELLT IM MAI 2021. VORHER WURDE EVTL. DER BEGRIFF 'STERBEFALL' VERWENDET."@de,
    "TERM OPPRETTET MAI 2021. TIDLIGERE VILLE BEGREPET 'DØDSFALL' BLITT BRUKT."@no, "TERME CRÉÉ EN MAI 2021. AUPARAVANT, LE TERME \"DEUIL\" POUVAIT ÊTRE UTILISÉ."@fr,
    "TERMEN SKAPADES I MAJ 2021. INNAN DESS KAN TERMEN \"DÖDSFALL\" HA ANVÄNTS."@sv, "TÉRMINO CREADO EN MAYO DE 2021. ANTERIORMENTE SE UTILIZABA EL TÉRMINO \"LUTO\"."@es,
    "TERMINAS SUKURTAS 2021 M.  ANKSČIAU BUVO NAUDOJAMAS TERMINAS \"NETEKTIS\"."@lt, "TERM GECREËERD IN MEI 2021"@nl;
